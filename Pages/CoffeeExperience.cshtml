@page
@model KopiCinta.Pages.CoffeeExperienceModel
@{
    ViewData["Title"] = "Coffee Experiences";
}

<section class="section">
    <div class="container">

        <div class="back-top reveal">
            <a asp-page="/Workshops">← Back</a>
        </div>

        <!-- HERO -->
        <div class="event-hero reveal">
            <div class="kbi-hero-text">
                <p class="eyebrow">Workshops & Learning</p>
                <h2>Coffee Experiences</h2>

                <p class="event-intro">
                    A guided coffee experience where every cup becomes a bridge
                    for sign language, Deaf awareness, and meaningful connection.
                </p>

                
            </div>

            <div class="event-hero-img">
                <img src="/images/coffee-experience/coffe experience-27.jpg" alt="Coffee Experiences gathering">
            </div>
        </div>

        <!-- QUOTE -->
        <div class="hbii-quote reveal">
            <p>
                “Not just through taste, but through something more personal,
                more present, and more meaningful.”
            </p>
        </div>

        <!-- STORY 1 -->
        <div class="hbii-block reveal">
            <div class="hbii-block-text">
                <p class="hbii-label">Since 2024</p>
                <h3>A Different Way to Experience Coffee</h3>

                <p>
                    Since 2024, Kopi Cinta began exploring a different way of experiencing coffee.
                    Not only through taste, but through presence, interaction, and shared meaning.
                </p>

                <p>
                    Coffee Experiences was created as a space where people could gather,
                    learn, and connect through something familiar: a cup of coffee.
                </p>
            </div>

            <div class="hbii-block-card">
                <h4>Who Joined</h4>
                <ul>
                    <li>Local communities in Malang</li>
                    <li>Teachers from special education schools</li>
                    <li>Government institutions</li>
                    <li>People curious about Deaf awareness</li>
                </ul>
            </div>
        </div>

        <!-- IMAGE BREAK -->
        <div class="featured-grid reveal">
            <img src="/images/coffee-experience/coffe experience-28.jpg" alt="Participants joining Coffee Experiences">
            <img src="/images/coffee-experience/DSCF2904.JPG" alt="Coffee being served during Coffee Experiences">
            <img src="/images/coffee-experience/coffe experience-40.jpg" alt="Participants learning together">
        </div>

        <!-- STORY 2 -->
        <div class="hbii-feature reveal">
            <div class="hbii-feature-card">
                <p class="hbii-label">The Gathering</p>
                <h3>A Warm Space to Share</h3>

                <p>
                    Participants were invited to sit in the same room, not simply to drink coffee,
                    but to share, learn, and understand.
                </p>

                <p>
                    There was no distance in that room—only conversations that flowed naturally,
                    warm, unfiltered, and real.
                </p>
            </div>

            <div class="hbii-feature-card soft">
                <p class="hbii-label">The Learning</p>
                <h3>Not a Formal Class</h3>

                <p>
                    Coffee Experiences was never meant to feel like a rigid lesson.
                    Participants learned sign language through interaction instead.
                </p>

                <p>
                    It happened through questions, small exchanges, and quiet moments in between.
                    We wanted people not only to understand, but to feel.
                </p>
            </div>
        </div>

        <!-- STORY 3 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/coffee-experience/DSCF4670.JPG" class="kbi-slide active" alt="Coffee Experiences sign language session">
                <img src="/images/coffee-experience/coffe experience-43.jpg" class="kbi-slide" alt="Participants practicing sign language">
                <img src="/images/coffee-experience/DSCF4301.JPG" class="kbi-slide" alt="Participants learning sign language">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Inspired by Omakase, Made with Heart</h3>

                <p>
                    Inspired by omakase, each experience was served personally and step by step.
                    Our Deaf baristas guided the session while sharing about Deaf awareness,
                    sign language, and personal stories that are not always heard.
                </p>

                <p>
                    This made the session feel more intimate, thoughtful, and human.
                </p>
            </div>
        </div>

        <!-- STORY 4 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/coffee-experience/DSCF2908.JPG" class="kbi-slide active" alt="Coffee being poured">
                <img src="/images/coffee-experience/DSCF4294.JPG" class="kbi-slide" alt="Drink being served during Coffee Experiences">
                <img src="/images/coffee-experience/DSCF4302.JPG" class="kbi-slide" alt="Coffee experience drink preparation">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Every Cup Became Part of the Story</h3>

                <p>
                    In between conversations, coffee was served directly in front of each participant,
                    from Kopi Susu Cinta to other special selections.
                </p>

                <p>
                    There were moments when coffee was poured slowly,
                    and moments where live latte art became part of the experience.
                    Everything was presented not just to be enjoyed, but to be remembered.
                </p>
            </div>
        </div>

        <!-- STORY 5 -->
        <div class="hbii-block reverse reveal">
            <div class="hbii-block-text">
                <p class="hbii-label">Connection</p>
                <h3>Conversations That Matter</h3>

                <p>
                    More than a learning session, Coffee Experiences is about conversation.
                    About how language can be found, even without sound.
                </p>

                <p>
                    It is about someone trying for the first time,
                    and someone else choosing to understand.
                </p>
            </div>

            <div class="hbii-highlight-panel">
                <div>
                    <strong>Share</strong>
                    <span>Stories became part of the learning.</span>
                </div>
                <div>
                    <strong>Try</strong>
                    <span>Participants practiced sign language naturally.</span>
                </div>
                <div>
                    <strong>Connect</strong>
                    <span>Every interaction became a bridge.</span>
                </div>
            </div>
        </div>

        <!-- IMAGE BREAK 2 -->
        <div class="featured-grid reveal">
            <img src="/images/coffee-experience/coffe experience-15.jpg" alt="Participants enjoying coffee">
            <img src="/images/coffee-experience/coffe experience-16.jpg" alt="Coffee Experiences participant interaction">
            <img src="/images/coffee-experience/coffe experience-18.jpg" alt="Participants learning sign language">
        </div>

        <!-- CLOSING -->
        <div class="hbii-ending reveal">
            <h3>More Than Just Coffee</h3>

            <p>
                For Kopi Cinta, Coffee Experiences is an extension of what we believe:
                coffee can be a bridge, and sign language can be the beginning of empathy.
            </p>

            <p>
                Even the smallest encounter can leave something that lasts.
            </p>
        </div>

        <br />

        <div class="detail-back reveal">
            <a asp-page="/Workshops" class="btn btn-secondary">← Back to Workshops </a>
        </div>

    </div>
</section>