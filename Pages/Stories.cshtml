@page
@model KopiCinta.Pages.StoriesModel
@{
    ViewData["Title"] = "Stories";
}

<section class="section">
    <div class="container">

        <!-- HEADER -->
        <div class="section-head reveal">
            <p class="eyebrow">Stories & Perspectives</p>
            <h2>A space for shared voices.</h2>
            <p>
                Soon, this page will become a blog where stories, reflections,
                and experiences are shared — not only by us, but also by the people
                who are part of the Kopi Cinta journey.
            </p>
        </div>

        <!-- COMING SOON -->
        <div class="hero-card reveal" style="max-width:720px; margin: 0 auto; text-align:center;">
            <span class="pill">Coming Soon</span>
            <h3>Stories are on the way.</h3>
            <p>
                We’re preparing a space where both our team and our community
                can share their perspectives — from workshops, interactions,
                personal reflections, and moments that felt meaningful.
            </p>
            <p>
                Because every experience holds a story,
                and every story deserves to be shared.
            </p>
        </div>

        <!-- OPTIONAL CTA -->
        <div class="detail-back reveal" style="text-align:center; margin-top:2rem;">
            <a asp-page="/Community" class="btn btn-secondary">Explore Community Instead</a>
        </div>

    </div>
</section>