@page
@model KopiCinta.Pages.StoriesModel
@{
    ViewData["Title"] = "Stories";
}
<section class="section">
    <div class="container">

        <div class="section-head">
            <p class="eyebrow">Stories & Perspectives</p>
            <h2>Real stories. Real people. Real connection.</h2>
            <p>
                This is where voices are shared, experiences are highlighted, and the meaning behind learning sign language comes to life.
            </p>
        </div>

        <!-- FEATURE -->
        <article class="story-card large reveal">
            <div class="story-tag">Featured</div>
            <h3>“It started with just one sign…”</h3>
            <p>
                A journey into how one small step into sign language opened up a completely new way of connecting with others.
            </p>
            <a href="#" class="text-link">Read full story →</a>
        </article>

        <!-- GRID -->
        <div class="intro-grid">

            <article class="story-card reveal">
                <div class="story-tag soft">Community</div>
                <h3>Inside our sign language workshop</h3>
                <p>Moments of learning, curiosity, and shared growth.</p>
            </article>

            <article class="story-card reveal">
                <div class="story-tag soft">Perspective</div>
                <h3>Why inclusivity matters in communication</h3>
                <p>Breaking barriers through awareness and empathy.</p>
            </article>

            <article class="story-card reveal">
                <div class="story-tag soft">Campaign</div>
                <h3>Cinta Bahasa Isyarat highlights</h3>
                <p>A look into the campaign that brought people together.</p>
            </article>

        </div>

    </div>
</section>
