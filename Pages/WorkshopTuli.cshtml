@page
@model KopiCinta.Pages.WorkshopTuliModel
@{
    ViewData["Title"] = "Workshop Tuli";
}

<section class="section">
    <div class="container">

        <!-- HERO -->
        <div class="detail-hero reveal">
            <div class="detail-hero-text">
                <p class="eyebrow">Experiences</p>
                <h2>Workshop Tuli</h2>
                <p>
                    A meaningful learning experience that introduces participants to Deaf culture,
                    communication, and sign language through an interactive workshop setting.
                </p>
            </div>

            <div class="detail-hero-slider" data-slider>
                <img src="/images/workshop-tuli-1.jpg" class="detail-hero-img active" alt="Workshop Tuli image 1">
                <img src="/images/workshop-tuli-2.jpg" class="detail-hero-img" alt="Workshop Tuli image 2">
                <img src="/images/workshop-tuli-3.jpg" class="detail-hero-img" alt="Workshop Tuli image 3">

                <button type="button" class="detail-slide-btn prev" data-prev>‹</button>
                <button type="button" class="detail-slide-btn next" data-next>›</button>
            </div>
        </div>

        <!-- STORY -->
        <div class="detail-section reveal">
            <h3>About This Experience</h3>
            <p>
                This session was designed to create awareness, build understanding, and encourage more
                inclusive communication through exposure to sign language and Deaf perspectives.
            </p>
            <p>
                Through interactive activities and guided learning, participants were given the
                opportunity to engage with the experience in a more personal and meaningful way.
            </p>
        </div>

        <!-- HIGHLIGHTS -->
        <div class="detail-section reveal">
            <h3>Highlights</h3>
            <div class="detail-highlight-grid">
                <div class="detail-highlight-card">
                    <h4>Interactive Learning</h4>
                    <p>Participants engaged directly through workshop activities and practical exposure.</p>
                </div>

                <div class="detail-highlight-card">
                    <h4>Community Connection</h4>
                    <p>The session created space for connection, empathy, and meaningful conversation.</p>
                </div>

                <div class="detail-highlight-card">
                    <h4>Inclusive Awareness</h4>
                    <p>The experience encouraged better understanding of accessibility and communication.</p>
                </div>
            </div>
        </div>

        <!-- GALLERY -->
        <div class="detail-section reveal">
            <h3>Gallery</h3>
            <div class="detail-gallery">
                <img src="/images/workshop-tuli-1.jpg" class="detail-thumb active-thumb" alt="Gallery 1">
                <img src="/images/workshop-tuli-2.jpg" class="detail-thumb" alt="Gallery 2">
                <img src="/images/workshop-tuli-3.jpg" class="detail-thumb" alt="Gallery 3">
                <img src="/images/workshop-tuli-4.jpg" class="detail-thumb" alt="Gallery 4">
                <img src="/images/workshop-tuli-5.jpg" class="detail-thumb" alt="Gallery 5">
            </div>
        </div>

        <!-- BACK -->
        <div class="detail-back reveal">
            <a asp-page="/Workshops" class="btn btn-secondary">← Back to Workshops</a>
        </div>

    </div>
</section>
