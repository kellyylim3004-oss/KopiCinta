@page
@model KopiCinta.Pages.ContactModel
@{
    ViewData["Title"] = "Contact";
}
<section class="section">
    <div class="container">

        <div class="section-head">
            <p class="eyebrow">Get Involved</p>
            <h2>Let’s create something meaningful together.</h2>
            <p>
                Whether you’re a brand, school, community, or individual, Kopi Cinta welcomes collaborations, workshops, and shared initiatives that support Deaf awareness and inclusive experiences.
            </p>
        </div>

        <div class="contact-layout">

            <!-- LEFT SIDE (TEXT) -->
            <div class="contact-card reveal">
                <h3>Work with us</h3>
                <p>
                    We collaborate with organizations, brands, and communities to create meaningful programs, workshops, and experiences.
                </p>

                <br />

                <p><strong>What you can reach out for:</strong></p>
                <ul>
                    <li>Workshops & awareness programs</li>
                    <li>Community collaborations</li>
                    <li>Coffee experiences & events</li>
                    <li>Partnership opportunities</li>
                </ul>

                <br />

                <p>
                    The easiest way to connect with us is through Instagram.
                </p>

                <a href="https://instagram.com/_kopicinta_" target="_blank" class="btn btn-primary">
                    Open Instagram →
                </a>
            </div>

            <!-- RIGHT SIDE (QR CODE) -->
            <div class="contact-card contact-qr reveal">

                <span class="pill">Scan to connect</span>

                <div class="qr-wrapper">
                    <img src="/images/qr.png" alt="Kopi Cinta Instagram QR" class="qr-img">
                </div>

                <p class="qr-username">
                    @@_kopicinta_
                </p>

                <p class="hero-text">
                    Scan this QR code to go directly to our Instagram and send us a message.
                </p>

            </div>

        </div>

    </div>
</section>