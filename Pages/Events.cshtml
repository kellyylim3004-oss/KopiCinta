@page
@model KopiCinta.Pages.EventsModel
@{
    ViewData["Title"] = "Events & Engagements";
}

<section class="section">
    <div class="container">

        <div class="tt-hero section-head reveal">
            <p class="eyebrow">Experiences</p>

            <h2>
                Events & Engagements
            </h2>

            <p class="tt-intro">
                Appearances, invited visits, and public engagements
                that connect Kopi Cinta with wider audiences.
            </p>
        </div>

        <div class="exp-grid">

            <a href="/GoesToUniversities" class="exp-card-lg reveal">
                <div class="exp-card-img">
                    <img src="/images/universities/cover.jpg" alt="">

                </div>
                <div class="exp-card-content">
                    <h3>Goes to Universities</h3>
                    <p>University visits and invited engagements that create awareness, dialogue, and connection.</p>
                    <span class="exp-readmore">Read More </span>
                </div>
            </a>

        </div>

    </div>
</section>