@page
@model KopiCinta.Pages.TakeOneLeaveOneModel
@{
    ViewData["Title"] = "Take One, Leave One";
}

<section class="section">
    <div class="container">

        <div class="back-top reveal">
            <a asp-page="/Community">← Back</a>
        </div>

        <!-- HERO -->
        <div class="kbi-hero reveal">
            <div class="kbi-hero-text">
                <p class="eyebrow">Community & Outreach</p>
                <h2>Take One, Leave One</h2>
                <p>
                    If love had no sounds, what would you say?
                </p>
            </div>

            <div class="kbi-hero-image">
                <img src="/images/take-one/take-hero.jpg" alt="">
            </div>
        </div>

        <!-- SECTION 1 -->
        <div class="kbi-section reveal">
            <div class="kbi-hero-image">
                <img src="/images/take-one/take1.jpg" alt="">
            </div>

            <div class="kbi-text">
                <h3>A Question About Love</h3>
                <p>
                    Di tengah ramainya Car Free Day Kota Malang, kami menghadirkan
                    sebuah sudut kecil sebagai bagian dari campaign Valentine kami.
                </p>
                <p>
                    Sebuah ruang sederhana, yang mengajak orang untuk berhenti
                    sejenak dan memikirkan satu hal:
                </p>
                <p><strong>Jika cinta tidak memiliki suara, apa yang akan kamu sampaikan?</strong></p>
            </div>
        </div>

        <!-- SECTION 2 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-hero-image">
                <img src="/images/take-one/take2.jpg" alt="">
            </div>

            <div class="kbi-text">
                <h3>Take One, But Learn Something</h3>
                <p>
                    Kami menyiapkan papan berisi gantungan kunci spesial dari KOPI CINTA,
                    masing-masing dilengkapi dengan trivia dan fun fact tentang dunia Tuli.
                </p>
                <p>
                    Sekilas terlihat sederhana, tapi kami ingin setiap orang membawa pulang
                    lebih dari sekadar benda — sebuah pengetahuan baru.
                </p>
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="kbi-section reveal">
            <div class="kbi-hero-image">
                <img src="/images/take-one/take3.jpg" alt="">
            </div>

            <div class="kbi-text">
                <h3>Connect Before You Take</h3>
                <p>
                    Untuk bisa mengambil satu gantungan kunci, setiap orang diajak
                    untuk berinteraksi terlebih dahulu.
                </p>
                <p>
                    Mereka berkomunikasi langsung dengan teman Tuli kami —
                    mencoba memahami, belajar, dan merasakan bagaimana koneksi
                    bisa terjalin tanpa suara.
                </p>
            </div>
        </div>

        <!-- SECTION 4 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-hero-image">
                <img src="/images/take-one/take4.jpg" alt="">
            </div>

            <div class="kbi-text">
                <h3>Leave One, From the Heart</h3>
                <p>
                    Setelah itu, mereka diajak meninggalkan sesuatu — bukan barang,
                    tetapi kata-kata.
                </p>
                <p>
                    Melalui sticky notes, mereka menuliskan pesan mereka,
                    menjawab pertanyaan:
                </p>
                <p><strong>“If love had no sounds, what would you say?”</strong></p>
                <p>
                    Dari sana muncul berbagai jawaban yang jujur, hangat, dan penuh rasa.
                </p>
            </div>
        </div>

        <!-- CLOSING -->
        <div class="detail-section reveal" style="text-align:center;">
            <h3>Even Without Sound, Love Speaks</h3>
            <p>
                Hari itu mungkin berlalu seperti biasa. Orang-orang datang dan pergi.
            </p>
            <p>
                Tapi kata-kata yang mereka tinggalkan tetap ada —
                menjadi pengingat bahwa, bahkan tanpa suara,
                cinta selalu menemukan caranya untuk berbicara.
            </p>
        </div>

        <div class="detail-back reveal">
            <a asp-page="/Community" class="btn btn-secondary">← Back to Community & Outreach</a>
        </div>

    </div>
</section>