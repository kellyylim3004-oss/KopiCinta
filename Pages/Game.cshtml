@page
@model KopiCinta.Pages.GameModel
@{
    ViewData["Title"] = "Kopi Cinta Runner";
}

<section class="section">
    <div class="container">

        <div class="section-head">
            <p class="eyebrow">Interactive Game</p>
            <h2>Kopi Cinta Runner</h2>
            <p>
                A simple web-based runner game inspired by Kopi Cinta’s playful spirit,
                where users move, collect hearts, and avoid coffee cup obstacles.
            </p>
        </div>

        <div class="hero-grid">
            <div class="hero-copy">
                <span class="pill">Play & Explore</span>

                <h3 style="margin-top: 16px;">Run, collect hearts, and avoid obstacles.</h3>

                <p class="hero-text">
                    Kopi Cinta Runner is a light interactive experience created to make the
                    website more engaging. Players control the character by moving left and
                    right, collecting heart points while avoiding coffee obstacles along the way.
                </p>

                <p class="hero-text">
                    The game can be played using keyboard controls on desktop or drag controls
                    on mobile, making it easy for visitors to try directly from the website.
                </p>

                <div class="hero-actions">
                    <a class="btn btn-primary" href="/game/index.html">Launch Game</a>
                </div>
            </div>

            <div class="hero-card">
                <h3>How to Play</h3>
                <p><strong>Desktop:</strong> Use the left and right arrow keys to move.</p>
                <p><strong>Mobile:</strong> Drag left or right to control the player.</p>
                <p><strong>Goal:</strong> Collect as many hearts as possible and avoid the coffee cups.</p>
            </div>
        </div>

    </div>
</section>