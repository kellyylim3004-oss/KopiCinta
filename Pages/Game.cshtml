@page
@model KopiCinta.Pages.GameModel
@{
    ViewData["Title"] = "Game";
}
<section class="section">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">Game</p>
            <h2>Learn through play.</h2>
            <p>
                This section introduces the interactive learning game and can later link directly to your playable game.
            </p>
        </div>

        <div class="hero-grid">
            <div class="hero-copy">
                <span class="pill">Interactive Learning</span>
                <h3 style="margin-top: 16px;">Sign Runner / Learning Game</h3>
                <p class="hero-text">
                    A playful learning activity where users engage with sign-related prompts, collect the right answers, and build familiarity through repeated interaction.
                </p>

                <div class="hero-actions">
                    <a class="btn btn-primary" href="/games/signrunner/index.html">Launch Game</a>
                </div>
            </div>

            <div class="hero-card">
                <h3>Game Preview</h3>
                <p>
                    A basic front-end preview area for your game feature. This can later be replaced with your real embedded game or direct launch screen.
                </p>
            </div>
        </div>
    </div>
</section>
