@page
@model KopiCinta.Pages.CommunityModel
@{
    ViewData["Title"] = "Community & Outreach";
}

<section class="section">
    <div class="container">

        <div class="tt-hero section-head reveal">
            <p class="eyebrow">Experiences</p>

            <h2>
                Community & Outreach
            </h2>

            <p class="tt-intro">
                Giving back through social impact, meaningful initiatives,
                and community connection.
            </p>
        </div>

        <div class="exp-grid">

            <!-- Coffee Blessings -->
            <a href="/CoffeeBlessings" class="exp-card-lg reveal">
                <img src="/images/CoffeeBlessings/coffee-pause-1.jpg" alt="Coffee Blessings" class="exp-card-img" />
                <div class="exp-card-content">
                    <h3>Coffee Blessings</h3>
                    <p>A community initiative centered on sharing, care, and meaningful connection.</p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Coffee Blessings Komunitas -->
            <a href="/CoffeeBlessingsKomunitas" class="exp-card-lg reveal">
                <img src="/images/BlessingsKomunitas/coffee-latte-1.jpg" alt="BlessingsKomunitas" class="exp-card-img" />
                <div class="exp-card-content">
                    <h3>Coffee Blessings Komunitas</h3>
                    <p>An outreach effort that extends kindness and connection to wider communities.</p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Take One Leave One -->
            <a href="/TakeOneLeaveOne" class="exp-card-lg reveal">
                <img src="/images/take-one/take2.jpg" alt="TakeOneLeaveOne" class="exp-card-img" />
                <div class="exp-card-content">
                    <h3>Take One Leave One</h3>
                    <p>A meaningful initiative built around simple acts of giving and receiving.</p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Bookmark Special -->
            <a href="/BookmarkSpecial" class="exp-card-lg reveal">
                <img src="/images/bookmark-special/foto harmoni-16.jpg" alt="Bookmark Special Hari Disabilitas Internasional" class="exp-card-img" />
                <div class="exp-card-content">
                    <h3>Bookmark Special Hari Disabilitas Internasional</h3>
                    <p>
                        A small yet meaningful initiative using bookmarks to raise awareness
                        about reading and introduce sign language to the wider community.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Cinta Dari Hulu ke Hilir -->
            <a href="/CintaDariHuluKeHilir" class="exp-card-lg reveal">
                <img src="/images/CintaDariHuluKeHilir/hulu-hilir9.jpg" alt="CintaDariHuluKeHilir" class="exp-card-img" />
                <div class="exp-card-content">
                    <h3>Cinta Dari Hulu ke Hilir</h3>
                    <p>A community-focused journey that reflects care and impact from beginning to end.</p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Apa Arti Cinta -->
            <a href="/ApaArtiCinta" class="exp-card-lg reveal">
                <img src="/images/apa-arti-cinta/IMG-20260429-WA0018.jpg" alt="ApaArtiCinta" class="exp-card-img" />
                <div class="exp-card-content">
                    <h3>Apa Arti Cinta Jika Tidak Semua Orang Bisa Merasakannya</h3>
                    <p>A reflective initiative exploring inclusion, accessibility, and shared human experience.</p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

        </div>

    </div>
</section>