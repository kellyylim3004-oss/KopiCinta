@page
@model KopiCinta.Pages.HBIIdanHDIModel
@{
    ViewData["Title"] = "International Sign Language Day";
}

<section class="section">
    <div class="container">

        <div class="back-top reveal">
            <a asp-page="/Collaborations">← Back</a>
        </div>

        <!-- HERO -->
        <div class="event-hero reveal">
            <div class="event-hero-text">
                <p class="eyebrow">Collaborations & Campaigns</p>
                <h2>International Sign Language Day</h2>
                <p class="event-intro">
                    A space to gather, connect, and celebrate togetherness through
                    shared moments, conversation, and presence.
                </p>

                <div class="event-tags">
                    <span>Celebration</span>
                    <span>Togetherness</span>
                    <span>Inclusive Space</span>
                </div>
            </div>

            <div class="video-card">
                <video controls playsinline preload="metadata">
                    <source src="/videos/hbii-hdi/hbii-2025-stop-motion.mp4" type="video/mp4" />
                </video>
            </div>
        </div>

        <!-- QUOTE BLOCK -->
        <div class="hbii-quote reveal">
            <p>
                “What truly matters is not just the celebration —
                but the connection it creates.”
            </p>
        </div>

        <!-- STORY BLOCK 1 -->
        <div class="hbii-block reveal">
            <div class="hbii-block-text">
                <p class="hbii-label">A Space to Gather</p>
                <h3>Togetherness First</h3>
                <p>
                    There are moments when togetherness means everything.
                    For us, International Sign Language Day is one of them.
                </p>
                <p>
                    Through this celebration, we invited Deaf friends to come together,
                    connect, and share meaningful time in one shared space.
                </p>
            </div>

            <div class="hbii-block-card">
                <h4>What We Created</h4>
                <ul>
                    <li>A welcoming gathering space</li>
                    <li>A warm shared celebration</li>
                    <li>A moment of genuine connection</li>
                </ul>
            </div>
        </div>

        <!-- STORY BLOCK 2 -->
        <div class="hbii-feature reveal">
            <div class="hbii-feature-card">
                <p class="hbii-label">Warmth in Small Things</p>
                <h3>A Simple Moment, Filled with Warmth</h3>
                <p>
                    We provided a free breakfast through Sarapan Pagi by Harmoni,
                    along with Kopi Cinta served directly by our Deaf baristas.
                </p>
                <p>
                    It was simple, but meaningful — the kind of moment that feels small
                    on the surface and deeply human underneath.
                </p>
            </div>

            <div class="hbii-feature-card soft">
                <p class="hbii-label">No Barriers</p>
                <h3>Connection Without Distance</h3>
                <p>
                    People from different backgrounds came together, bringing their own stories.
                    There were no formalities and no barriers — just people connecting in their own way.
                </p>
            </div>
        </div>

        <!-- STORY BLOCK 3 -->
        <div class="hbii-block reverse reveal">
            <div class="hbii-block-text">
                <p class="hbii-label">Belonging</p>
                <h3>More Than a Celebration</h3>
                <p>
                    For us, this celebration is more than marking a date.
                    It is about creating a space that feels safe, welcoming, and inclusive.
                </p>
                <p>
                    A place where everyone can be themselves,
                    and feel that they belong.
                </p>
            </div>

            <div class="hbii-highlight-panel">
                <div>
                    <strong>Safe</strong>
                    <span>A space without pressure or distance.</span>
                </div>
                <div>
                    <strong>Welcoming</strong>
                    <span>A place where people arrive and feel received.</span>
                </div>
                <div>
                    <strong>Inclusive</strong>
                    <span>A celebration shaped by connection, not formality.</span>
                </div>
            </div>
        </div>

        <!-- ENDING -->
        <div class="hbii-ending reveal">
            <h3>Because Connection Matters</h3>
            <p>
                In the end, what stays with us is not only the event itself,
                but the sense of closeness, comfort, and belonging created within it.
            </p>
        </div>
        <br>
        <div class="detail-back reveal">
            <a asp-page="/Collaborations" class="btn btn-secondary">← Back to Collaborations</a>
        </div>

    </div>
</section>