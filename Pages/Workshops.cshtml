@page
@model KopiCinta.Pages.WorkshopsModel
@{
    ViewData["Title"] = "Workshops & Learning";
}

<section class="section">
    <div class="container">

        <!-- HERO -->
        <div class="tt-hero section-head reveal">
            <p class="eyebrow">Experiences</p>

            <h2>
                Workshops & Learning
            </h2>

            <p class="tt-intro">
                A collection of educational and interactive learning experiences
                centered around sign language, coffee, and meaningful connection.
            </p>
        </div>

        <!-- GRID -->
        <div class="exp-grid">

            <a href="/KelasBahasaIsyaratRutin" class="exp-card-lg reveal">
                <img src="/images/KelasBahasaIsyarat/kbi-cover.jpg" alt="Kelas Bahasa Isyarat Rutin" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>Kelas Bahasa Isyarat Rutin</h3>
                    <p>
                        Regular sign language classes that support continuous learning
                        and deeper engagement.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            

            <a href="/LetsSignItCorner" class="exp-card-lg reveal">
                <img src="/images/LetsSignItCorner/lsi-cover.jpg" alt="Let's Sign It Corner" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>Let’s Sign It Corner</h3>
                    <p>
                        A welcoming learning corner where visitors can explore
                        and practice sign language in a casual setting.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <a href="/CoffeeExperience" class="exp-card-lg reveal">
                <img src="/images/coffee-experience/coffe experience-24.jpg" alt="Coffee Experience" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>Coffee Experience</h3>
                    <p>
                        A hands-on learning experience that introduces coffee,
                        its process, and the meaningful stories behind each cup.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

        </div>

    </div>
</section>