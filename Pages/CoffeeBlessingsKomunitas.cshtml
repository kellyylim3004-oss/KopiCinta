@page
@model KopiCinta.Pages.CoffeeBlessingsKomunitasModel
@{
    ViewData["Title"] = "Coffee Blessings Komunitas";
}

<section class="section">
    <div class="container">

        <div class="back-top reveal">
            <a asp-page="/Community">← Back </a>
        </div>

        <!-- HERO -->
        <div class="kbi-hero reveal">
            <div class="kbi-hero-text">
                <p class="eyebrow">Community & Outreach</p>
                <h2>Coffee Blessings 2.0</h2>
                <p>
                    Sharing love, together — creating a space where communities can come,
                    connect, and feel accepted through warmth, conversation, and coffee.
                </p>
            </div>

            <div class="kbi-hero-image">
                <img src="/images/BlessingsKomunitas/blessings-komunitas-hero.jpg">
            </div>
        </div>

        <!-- SECTION 1 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/BlessingsKomunitas/coffee-komunitas-1.jpg" class="kbi-slide active" alt="A table for everyone 1">
                <img src="/images/BlessingsKomunitas/coffee-komunitas-2.jpg" class="kbi-slide" alt="A table for everyone 2">
                <img src="/images/BlessingsKomunitas/coffee-komunitas-3.jpg" class="kbi-slide" alt="A table for everyone 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>A Table for Everyone</h3>
                <p>
                    Ada momen di mana berbagi tidak perlu pergi jauh. Cukup dengan
                    menghadirkan ruang, dan mengundang orang-orang untuk datang dan
                    merasa diterima.
                </p>
                <p>
                    Melalui Coffee Blessings 2.0, kami menciptakan ruang sederhana,
                    tapi penuh makna.
                </p>
                <p>
                    Kami mengundang berbagai komunitas lokal mulai dari Akar Tuli,
                    Harapan Ummat, SpeakUp, Kasih Baca, hingga Islamic Disability Center
                    untuk duduk bersama dalam satu meja.
                </p>
                <p>
                    Bukan sebagai tamu, tapi sebagai bagian dari cerita yang sama.
                </p>

                
            </div>
        </div>

        <!-- SECTION 2 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/BlessingsKomunitas/coffee-sarapan-1.jpg" class="kbi-slide active" alt="A morning to share 1">
                <img src="/images/BlessingsKomunitas/coffee-sarapan-2.jpg" class="kbi-slide" alt="A morning to share 2">
                <img src="/images/BlessingsKomunitas/coffee-sarapan-3.jpg" class="kbi-slide" alt="A morning to share 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>A Morning to Share</h3>
                <p>
                    Kami memulai hari dengan sarapan pagi bersama lewat
                    <em>Sarapan Pagi by Harmoni</em> yang kami hadirkan sebagai bagian
                    dari pengalaman ini.
                </p>
                <p>
                    Di antara makanan yang tersaji dan percakapan yang mengalir,
                    kami melihat sesuatu yang sederhana tapi berarti: CINTA.
                </p>
                <p>
                    Di tengah suasana itu, kopi menjadi jembatan yang menyatukan.
                </p>

                
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/BlessingsKomunitas/coffee-latte-1.jpg" class="kbi-slide active" alt="Latte art 1">
                <img src="/images/BlessingsKomunitas/coffee-latte-2.jpg" class="kbi-slide" alt="Latte art 2">
                <img src="/images/BlessingsKomunitas/coffee-latte-3.jpg" class="kbi-slide" alt="Latte art 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Coffee as a Bridge</h3>
                <p>
                    Melalui live latte art yang dibawakan oleh Alif, salah satu barista
                    Tuli kami, setiap cangkir disajikan dengan penuh ketulusan.
                </p>
                <p>
                    Bukan hanya tentang teknik, tapi tentang cerita di baliknya —
                    tentang perjalanan, tentang keberanian, dan tentang bagaimana
                    setiap detail kecil bisa membawa kebahagiaan.
                </p>

                
            </div>
        </div>

        <!-- SECTION 4 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/BlessingsKomunitas/coffee-growth-1.jpg" class="kbi-slide active" alt="Love grows when shared 1">
                <img src="/images/BlessingsKomunitas/coffee-growth-2.jpg" class="kbi-slide" alt="Love grows when shared 2">
                <img src="/images/BlessingsKomunitas/coffee-growth-3.jpg" class="kbi-slide" alt="Love grows when shared 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Because Love Grows When Shared</h3>
                <p>
                    Tentang bagaimana cinta bisa hadir dalam bentuk yang sederhana.
                </p>
                <p>
                    Kami tidak hanya berbagi kopi. Kami berbagi waktu, perhatian,
                    dan kehangatan.
                </p>
                <p>
                    Melalui Coffee Blessings (Inside), kami ingin terus mengingatkan
                    bahwa cinta tidak selalu harus besar untuk berarti.
                </p>
                <p>
                    Karena saat dibagikan, CINTA selalu menemukan jalannya untuk tumbuh.
                </p>

                
            </div>
        </div>

        <div class="detail-back reveal">
            <a asp-page="/Community" class="btn btn-secondary">← Back to Community & Outreach</a>
        </div>

    </div>
</section>