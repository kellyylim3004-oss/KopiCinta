@page
@model KopiCinta.Pages.LetsSignItCornerModel
@{
    ViewData["Title"] = "Let’s Sign It Corner";
}

<section class="section">
    <div class="container">

        <!-- HERO -->
        <div class="back-top">
            <a asp-page="/Workshops">← Back </a>
        </div>
        <div class="kbi-hero reveal">
            <div class="kbi-hero-text">
                <p class="eyebrow">Experiences</p>
                <h2>Let’s Sign It! Corner</h2>
                <p>
                    Where hands speak louder than words — a space to pause,
                    learn, and connect through sign language.
                </p>
            </div>

            <div class="kbi-hero-image">
                <img src="/images/LetsSignItCorner/lsi-hero.jpg">
            </div>
        </div>

        <!-- SECTION 1 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/LetsSignItCorner/lsi-1.jpg" class="kbi-slide active">
                <img src="/images/LetsSignItCorner/lsi-2.jpg" class="kbi-slide">
                <img src="/images/LetsSignItCorner/lsi-3.jpg" class="kbi-slide">

                <button class="kbi-slide-btn prev" data-prev>‹</button>
                <button class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>A Space to Pause and Connect</h3>
                <p>
                    Setiap minggu di Car Free Day Kota Malang, Kopi Cinta menghadirkan
                    sebuah sudut kecil di tengah keramaian. Bukan sekadar untuk menarik
                    perhatian, tapi untuk mengajak orang berhenti sejenak dan merasakan
                    experience baru yang berbeda.
                </p>
                <p>
                    Di antara langkah kaki yang berlalu, kami percaya selalu ada ruang
                    untuk terhubung bahkan tanpa kata.
                </p>
            </div>
        </div>

        <!-- SECTION 2 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/LetsSignItCorner/lsi-learn-1.jpg" class="kbi-slide active">
                <img src="/images/LetsSignItCorner/lsi-learn-2.jpg" class="kbi-slide">
                <img src="/images/LetsSignItCorner/lsi-learn-3.jpg" class="kbi-slide">

                <button class="kbi-slide-btn prev" data-prev>‹</button>
                <button class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Learning Comes First</h3>
                <p>
                    Setiap permainan bukan tentang menang atau kalah,
                    melainkan tentang proses. Kami mengajak setiap orang
                    untuk belajar tentang dunia Tuli, dimulai dari bahasa
                    isyarat dasar seperti abjad dan kosakata sederhana.
                </p>
                <p>
                    Di awal mungkin terasa canggung, tapi perlahan mereka mulai
                    memahami cara baru untuk berkomunikasi.
                </p>
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/LetsSignItCorner/lsi-game-1.jpg" class="kbi-slide active">
                <img src="/images/LetsSignItCorner/lsi-game-2.jpg" class="kbi-slide">
                <img src="/images/LetsSignItCorner/lsi-game-3.jpg" class="kbi-slide">

                <button class="kbi-slide-btn prev" data-prev>‹</button>
                <button class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Game with Purpose</h3>
                <p>
                    Setelah belajar, dilanjutkan dengan permainan yang tidak hanya fun
                    tapi juga edukatif.
                </p>
                <p>
                    Roulette menentukan level tantangan, dan partisipan langsung
                    berinteraksi dengan barista Tuli untuk memahami bahasa isyarat.
                </p>
                <p>
                    Jika berhasil, mereka lanjut ke permainan lempar ring yang
                    membutuhkan strategi dan ketelitian.
                </p>
            </div>
        </div>

        <!-- SECTION 4 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/LetsSignItCorner/lsi-gift-1.jpg" class="kbi-slide active">
                <img src="/images/LetsSignItCorner/lsi-gift-2.jpg" class="kbi-slide">
                <img src="/images/LetsSignItCorner/lsi-gift-3.jpg" class="kbi-slide">

                <button class="kbi-slide-btn prev" data-prev>‹</button>
                <button class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Small Gifts, Bigger CINTA</h3>
                <p>
                    Hadiah kecil seperti stiker bahasa isyarat, gantungan kunci,
                    dan merchandise adalah bentuk apresiasi kami.
                </p>
                <p>
                    Lebih dari sekadar hadiah, ini tentang pengalaman dan perspektif
                    baru yang mereka bawa pulang.
                </p>
            </div>
        </div>

        <!-- CLOSING -->
        <div class="detail-section reveal" style="text-align:center;">
            <h3>Kami percaya, CINTA tidak selalu harus diucapkan</h3>
            <p>
                Jika suatu hari kamu datang dan menemukan kami di sana,
                jangan ragu untuk berhenti — mungkin kamu akan belajar
                sesuatu yang lebih dari sekadar permainan.
            </p>
        </div>

        <div class="detail-back reveal">
            <a asp-page="/Workshops" class="btn btn-secondary">← Back to Workshops</a>
        </div>

    </div>
</section>

