@page
@model KopiCinta.Pages.RunnerModel
@{
    ViewData["Title"] = "Kopi Cinta Runner";
}

<section class="section">
    <div class="container">

        <div class="tt-hero reveal">
            <p class="eyebrow">Interactive Game</p>
            <h2>Kopi Cinta Runner</h2>
            <p class="tt-intro">
                Play a simple endless runner experience inspired by the energy,
                movement, and fun of Kopi Cinta.
            </p>
        </div>

        <div style="width:100%; height:720px; border-radius:24px; overflow:hidden; box-shadow:var(--shadow-soft);">
            <iframe src="/game/index.html"
                    style="width:100%; height:100%; border:0;"
                    allowfullscreen>
            </iframe>
        </div>

    </div>
</section>
