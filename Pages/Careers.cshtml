@page
@model KopiCinta.Pages.CareersModel
@{
    ViewData["Title"] = "Careers";
}

<section class="section">
    <div class="container">

        <!-- HEADER -->
        <div class="section-head reveal">
            <p class="eyebrow">Join Us</p>
            <h2>Grow with Kopi Cinta</h2>
            <p>
                We believe in creating opportunities that are inclusive,
                meaningful, and built on connection.
            </p>
        </div>

        <!-- STATUS -->
        <div class="hero-card reveal" style="max-width:720px; margin: 0 auto; text-align:center;">
            <span class="pill">Currently</span>
            <h3>No openings available right now</h3>
            <p>
                At the moment, we don’t have any open positions.
                But Kopi Cinta is always growing, and new opportunities
                may open in the future.
            </p>
            <p>
                We’re building a space where everyone —
                including the Deaf community — can grow,
                contribute, and feel valued.
            </p>
            <p>
                Stay connected with us for future updates.
            </p>
        </div>

        <!-- OPTIONAL CTA -->
        <div class="detail-back reveal" style="text-align:center; margin-top:2rem;">
            <a href="https://www.instagram.com/" target="_blank" class="btn btn-secondary">
                Follow us for updates
            </a>
        </div>

    </div>
</section>