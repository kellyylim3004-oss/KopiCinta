@page
@model KopiCinta.Pages.CareersModel
@{
    ViewData["Title"] = "Careers";
}

<section class="section">
    <div class="container">

        <!-- HEADER -->
        <div class="section-head reveal">
            <p class="eyebrow">Join Us</p>
            <h2>Grow with Kopi Cinta</h2>
            <p>
                We believe in creating opportunities that are inclusive,
                meaningful, and built on connection.
            </p>
        </div>

        <!-- STATUS -->
        <div class="hero-card reveal" style="max-width:720px; margin: 0 auto; text-align:center;">
            <span class="pill">Careers</span>

            <h3>Be part of future opportunities at <br />Kopi Cinta</h3>

            <p>
                Kopi Cinta continues to grow through community,
                collaboration, and inclusive experiences.
            </p>

            <p>
                Future opportunities, volunteer openings, and collaborations
                will be shared through our Instagram.
            </p>

            <div style="margin-top:2rem;">
                <a href="https://www.instagram.com/_kopicinta_/" target="_blank" class="btn btn-primary">
                    Follow @@_kopicinta_
                </a>
            </div>
        </div>

    </div>
</section>