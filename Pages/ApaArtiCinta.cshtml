@page
@model KopiCinta.Pages.ApaArtiCintaModel
@{
    ViewData["Title"] = "Apa Arti Cinta?";
}

<section class="section">
    <div class="container">

        <div class="back-top reveal">
            <a asp-page="/Community">← Back</a>
        </div>

        <!-- HERO (AUTOPLAY VIDEO) -->
        <div class="kbi-hero reveal">
            <div class="kbi-hero-text">
                <p class="eyebrow">Community & Outreach</p>
                <h2>Apa Arti Cinta?</h2>
                <p>
                    What does love mean if not everyone can feel it?
                    A moment of connection, reflection, and shared understanding.
                </p>
            </div>

            <div class="kbi-hero-video">
                <video autoplay muted loop playsinline>
                    <source src="/videos/apa-arti-cinta/VID-20260429-WA0021.mp4" type="video/mp4">
                </video>
            </div>
        </div>

        <!-- INTRO -->
        <div class="detail-section reveal">
            <h3>Love That Everyone Can Feel</h3>
            <p>
                Through this Valentine’s campaign, we invited people to reflect on
                love that is inclusive—love that can be felt by everyone.
            </p>
        </div>

        <!-- SECTION 1 -->
        <div class="kbi-section reveal">
            <div class="kbi-img">
                <img src="/images/apa-arti-cinta/IMG-20260429-WA0018.jpg" alt="">
            </div>

            <div class="kbi-text">
                <h3>Fourteen Letters</h3>
                <p>
                    We created 14 handwritten letters, each carrying a different message
                    of love—designed to resonate with whoever reads them.
                </p>
            </div>
        </div>

        <!-- SECTION 2 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-img">
                <img src="/images/apa-arti-cinta/IMG-20260429-WA0022.jpg" alt="">
            </div>

            <div class="kbi-text">
                <h3>More Than Words</h3>
                <p>
                    Each letter included illustrations and a QR code connected to a song,
                    turning each message into a small emotional experience.
                </p>
            </div>
        </div>

        <!-- VIDEO SECTION -->
        <div class="kbi-section reveal">
            <div class="kbi-hero-video">
                <video autoplay muted loop playsinline>
                    <source src="/videos/apa-arti-cinta/VID-20260429-WA0023.mp4" type="video/mp4">
                </video>
            </div>

            <div class="kbi-text">
                <h3>A Space to Feel</h3>
                <p>
                    People stopped, read, listened, and reflected—
                    creating quiet but meaningful moments.
                </p>
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-img">
                <img src="/images/apa-arti-cinta/IMG-20260429-WA0007.jpg" alt="">
            </div>

            <div class="kbi-text">
                <h3>Learning Together</h3>
                <p>
                    Visitors joined games and learned sign language with our Deaf team,
                    creating connection through interaction.
                </p>
            </div>
        </div>

        <!-- SECTION 4 -->
        <div class="kbi-section reveal">
            <div class="kbi-img">
                <img src="/images/apa-arti-cinta/IMG-20260429-WA0024.jpg" alt="">
            </div>

            <div class="kbi-text">
                <h3>Open for Everyone</h3>
                <p>
                    Held at CFD Malang and Harmoni Cafe, the space welcomed anyone
                    to experience love and understanding.
                </p>
            </div>
        </div>

        <!-- FINAL VIDEO -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-hero-video">
                <video autoplay muted loop playsinline>
                    <source src="/videos/apa-arti-cinta/VID-20260429-WA0025.mp4" type="video/mp4">
                </video>
            </div>

            <div class="kbi-text">
                <h3>More Than a Campaign</h3>
                <p>
                    It became a shared experience—where people didn’t just receive love,
                    but also gave it back.
                </p>
            </div>
        </div>

        <!-- END -->
        <div class="detail-section reveal" style="text-align:center;">
            <h3>Love Finds a Way</h3>
            <p>
                That day, we didn’t just share love—
                we received it just as much.
            </p>
        </div>

        <div class="detail-back reveal">
            <a asp-page="/Community" class="btn btn-secondary">← Back to Community & Outreach</a>
        </div>

    </div>
</section>