@page
@model KopiCinta.Pages.ProjectsModel
@{
    ViewData["Title"] = "Projects";
}
<section class="section">
    <div class="container">

        <div class="section-head">
            <p class="eyebrow">Experiences</p>
            <h2>What we do at Kopi Cinta</h2>
            <p>Explore our workshops, community initiatives, collaborations, and events.</p>
        </div>

        <!-- WORKSHOPS -->
        <div id="workshops" class="exp-section">
            <h3>Workshops & Learning</h3>
            <div class="exp-grid">
                <div class="exp-card">
                    <div class="exp-img">

                    </div>
                    <h4>Kelas Bahasa Isyarat Rutin</h4>
                    <p>Regular sign language classes for beginners and learners.</p>
                </div>

                <div class="exp-card">
                    <div class="exp-img"></div>
                    <h4>Workshop Tuli</h4>
                    <p>Interactive workshops to raise awareness about Deaf culture.</p>
                </div>

                <div class="exp-card">
                    <div class="exp-img"></div>
                    <h4>Let’s Sign It Corner</h4>
                    <p>A casual learning space to practice sign language.</p>
                </div>
            </div>
        </div>

        <!-- COMMUNITY -->
        <div id="community" class="exp-section">
            <h3>Community & Outreach</h3>
            <div class="exp-grid"></div>
        </div>

        <!-- COLLABS -->
        <div id="collabs" class="exp-section">
            <h3>Collaborations & Campaigns</h3>
            <div class="exp-grid"></div>
        </div>

        <!-- EVENTS -->
        <div id="events" class="exp-section">
            <h3>Events & Engagements</h3>
            <div class="exp-grid"></div>
        </div>

    </div>
</section>