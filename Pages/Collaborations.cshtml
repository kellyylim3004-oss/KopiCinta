@page
@model KopiCinta.Pages.CollaborationsModel
@{
    ViewData["Title"] = "Collaborations & Campaigns";
}

<section class="section">
    <div class="container">

        <!-- HERO -->
        <div class="exp-hero">
            <div>
                <p class="eyebrow">Experiences</p>
                <h2>Collaborations & Campaigns</h2>
                <p>
                    Partnerships and collaborative initiatives that expand the reach of Kopi Cinta,
                    bringing together shared purpose, creativity, and impact.
                </p>
            </div>
            <div class="exp-hero-img"></div>
        </div>

        <!-- GRID -->
        <div class="exp-grid">

            <!-- Project E -->
            <a href="/ProjectE" class="exp-card-lg reveal">
                <img src="/images/project-e/15.jpg" alt="Kopi Cinta x Project E" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>Kopi Cinta x Project E</h3>
                    <p>
                        A collaborative initiative centered around learning, awareness,
                        and meaningful engagement through sign language.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Roti Arum -->
            <a href="/RotiArum" class="exp-card-lg reveal">
                <img src="/images/roti-arum/10.jpg" alt="C1nta untuk Roti Arum" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>C1nta untuk Roti Arum</h3>
                    <p>
                        A collaboration that brings together shared values of creativity,
                        inclusion, and meaningful connection through a partner brand.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Goes to Ranz -->
            <a href="/KopiCintaGoesToRanz" class="exp-card-lg reveal">
                <img src="/images/ranz/6.jpg" alt="Kopi Cinta Goes to Ranz" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>Kopi Cinta Goes to Ranz</h3>
                    <p>
                        A large-scale collaboration that brought Kopi Cinta
                        to a wider audience through shared space and interaction.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Roti Cinta by Ardisa -->
            <a href="/RotiCintaByArdisa" class="exp-card-lg reveal">
                <img src="/images/roti-cinta/cover.jpg" alt="Roti Cinta by Ardisa" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>Roti Cinta by Ardisa</h3>
                    <p>
                        A personal collaboration that highlights identity, creativity,
                        and expression through meaningful products.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- HBII & HDI -->
            <a href="/HBIIdanHDI" class="exp-card-lg reveal">
                <img src="/images/hbii-hdi/cover.jpg" alt="HBII dan HDI" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>HBII dan HDI</h3>
                    <p>
                        A collaborative effort built around awareness, celebration,
                        and shared commitment toward inclusivity.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

            <!-- Charis Opening -->
            <a href="/CharisOpening" class="exp-card-lg reveal">
                <img src="/images/charis/cover.jpg" alt="Charis Opening" class="exp-card-img" />

                <div class="exp-card-content">
                    <h3>Charis Opening</h3>
                    <p>
                        A special opening event shaped through collaboration,
                        bringing people together in a shared experience.
                    </p>
                    <span class="exp-readmore">Read More</span>
                </div>
            </a>

        </div>

    </div>
</section>