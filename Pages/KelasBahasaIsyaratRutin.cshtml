@page
@model KopiCinta.Pages.KelasBahasaIsyaratRutinModel
@{
    ViewData["Title"] = "Kelas Bahasa Isyarat Rutin";
}

<section class="section">
    <div class="container">

        <!-- BACK -->
        <div class="back-top">
            <a asp-page="/Workshops">← Back</a>
        </div>

        <!-- HERO -->
        <div class="kbi-hero reveal">
            <div class="kbi-hero-text">
                <p class="eyebrow">Workshops & Learning</p>
                <h2>Kelas Bahasa Isyarat Rutin</h2>
                <p>
                    A recurring sign language learning space designed to be
                    more personal, engaging, and meaningful for everyone.
                </p>
            </div>

            <div class="kbi-hero-image">
                <img src="/images/KelasBahasaIsyarat/kelas-bahasa-hero.jpg" alt="">
            </div>
        </div>

        <!-- 🔥 MAIN STORY (NEW - IMPORTANT) -->
        <div class="hbii-block reveal">

            <div class="hbii-block-text">
                <p class="hbii-label">Learning, One Step at a Time</p>
                <h3>A More Meaningful Learning Space</h3>

                <p>
                    For us, learning is a continuous journey. To truly understand,
                    we need the right space.
                </p>

                <p>
                    Through our regular sign language classes, we create a learning
                    environment that is more focused, more personal, and more meaningful.
                </p>

                <p>
                    Each class is limited to a maximum of 25 participants,
                    ensuring everyone receives enough attention and can learn comfortably.
                </p>
            </div>

            <div class="hbii-block-card">
                <h4>How the Class Works</h4>
                <ul>
                    <li>Max 25 participants per class</li>
                    <li>Held at least twice a month</li>
                    <li>Different theme each session</li>
                    <li>Open to all levels</li>
                </ul>
            </div>
        </div>

        <div class="hbii-feature reveal">

            <div class="hbii-feature-card">
                <p class="hbii-label">Learning Through Play</p>
                <h3>Not Just Theory</h3>

                <p>
                    The learning process is never rigid.
                    Simple games are included as ice breakers
                    and as a fun way to test understanding.
                </p>

                <p>
                    There is laughter, and within it,
                    learning happens naturally.
                </p>
            </div>

            <div class="hbii-feature-card soft">
                <p class="hbii-label">Led by Experience</p>
                <h3>Guided by Our Deaf Team</h3>

                <p>
                    Classes are led directly by our Deaf team —
                    Ardisa, Axel, Alif, and Nanda.
                </p>

                <p>
                    Participants don’t just learn a language,
                    but experience what it means to communicate,
                    understand, and connect.
                </p>
            </div>
        </div>

        <!-- =========================
            SESSIONS START HERE
        ========================== -->

        <!-- FEBRUARY -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/KelasBahasaIsyarat/kbifeb4.jpg" class="kbi-slide active">
                <img src="/images/KelasBahasaIsyarat/kbifeb2.jpg" class="kbi-slide">
                <img src="/images/KelasBahasaIsyarat/kbifeb3.jpg" class="kbi-slide">
                <img src="/images/KelasBahasaIsyarat/kbifeb5.jpg" class="kbi-slide">
                <img src="/images/KelasBahasaIsyarat/kbifeb1.jpg" class="kbi-slide">

                <button class="kbi-slide-btn prev" data-prev>‹</button>
                <button class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>KBI FEBRUARI X VALENTINE</h3>
                <p>
                    A themed session centered around expression, connection,
                    and communication in a warm and interactive setting.
                </p>
            </div>
        </div>

        <!-- RAMADHAN 14 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/KelasBahasaIsyarat/kbi-ramadhan14-1.jpg" class="kbi-slide active">
                <img src="/images/KelasBahasaIsyarat/kbi-ramadhan14-2.jpg" class="kbi-slide">
                <img src="/images/KelasBahasaIsyarat/kbi-ramadhan14-3.jpg" class="kbi-slide">
                <img src="/images/KelasBahasaIsyarat/kbi-ramadhan14-4.jpg" class="kbi-slide">
