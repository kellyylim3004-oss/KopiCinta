@page
@model KopiCinta.Pages.CoffeeBlessingsModel
@{
    ViewData["Title"] = "Coffee Blessings";
}

<section class="section">
    <div class="container">

        <div class="back-top reveal">
            <a asp-page="/Community">← Back </a>
        </div>

        <!-- HERO -->
        <div class="kbi-hero reveal">
            <div class="kbi-hero-text">
                <p class="eyebrow">Community & Outreach</p>
                <h2>Coffee Blessings</h2>
                <p>
                    Bringing CINTA, one cup at a time — a small pause, a shared moment,
                    and a reminder that everyone deserves appreciation.
                </p>
            </div>

            <div class="kbi-hero-image">
                <img src="/images/CoffeeBlessings/coffee-belief-2.jpg">
            </div>
        </div>

        <!-- SECTION 1 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/CoffeeBlessings/coffee-blessings-1.jpg" class="kbi-slide active" alt="Coffee Blessings 1">
                <img src="/images/CoffeeBlessings/coffee-blessings-2.jpg" class="kbi-slide" alt="Coffee Blessings 2">
                <img src="/images/CoffeeBlessings/coffee-blessings-3.jpg" class="kbi-slide" alt="Coffee Blessings 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>We Come to You</h3>
                <p>
                    Tidak semua orang punya waktu untuk berhenti, dan tidak semua orang sempat
                    datang untuk merasakan apa yang kami hadirkan.
                </p>
                <p>
                    Karena itu, kami memilih untuk melangkah keluar. Di berbagai sudut Kota Malang,
                    kami hadir di tengah aktivitas para pekerja — mulai dari kantor media,
                    ruang kreatif, hingga institusi dan perbankan.
                </p>
                <p>
                    Kami datang bukan hanya membawa kopi. Kami datang membawa sesuatu yang
                    sederhana, tapi sering terlupa: CINTA.
                </p>

                
            </div>
        </div>

        <!-- SECTION 2 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/CoffeeBlessings/coffee-pause-1.jpg" class="kbi-slide active" alt="Busy day pause 1">
                <img src="/images/CoffeeBlessings/coffee-pause-2.jpg" class="kbi-slide" alt="Busy day pause 2">
                <img src="/images/CoffeeBlessings/coffee-pause-3.jpg" class="kbi-slide" alt="Busy day pause 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>A Small Pause in a Busy Day</h3>
                <p>
                    Kami memahami, di balik layar pekerjaan dan target yang harus dicapai,
                    ada lelah yang jarang terlihat.
                </p>
                <p>
                    Melalui secangkir kopi yang kami sajikan langsung, kami ingin menghadirkan
                    jeda kecil — momen singkat untuk bernapas di tengah hari yang sibuk.
                </p>

                
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/CoffeeBlessings/coffee-belief-1.jpg" class="kbi-slide active" alt="Sharing belief 1">
                <img src="/images/CoffeeBlessings/coffee-belief-2.jpg" class="kbi-slide" alt="Sharing belief 2">
                <img src="/images/CoffeeBlessings/coffee-belief-3.jpg" class="kbi-slide" alt="Sharing belief 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Sharing What We Believe</h3>
                <p>
                    Setiap cangkir yang kami bagikan bukan hanya tentang rasa.
                    Ini adalah cara kami berbagi CINTA, nilai yang selalu kami bawa
                    dalam setiap langkah.
                </p>
                <p>
                    Kami percaya, setiap orang berhak mendapatkan apresiasi,
                    sekecil apapun bentuknya.
                </p>
                <p>
                    Dan terkadang, hal sederhana seperti secangkir kopi bisa menjadi
                    penyemangat di tengah hari yang panjang.
                </p>

            </div>
        </div>

        <!-- SECTION 4 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/CoffeeBlessings/coffee-love-1.jpg" class="kbi-slide active" alt="Love 1">
                <img src="/images/CoffeeBlessings/coffee-love-2.jpg" class="kbi-slide" alt="Love 2">
                <img src="/images/CoffeeBlessings/coffee-love-3.jpg" class="kbi-slide" alt="Love 3">



                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>More Than Just Coffee</h3>
                <p>
                    Coffee Blessings bukan hanya tentang memberi. Ini tentang hadir,
                    menyapa, dan mengingatkan bahwa mereka tidak sendiri.
                </p>
                <p>
                    Kami melihat senyum yang muncul, percakapan singkat yang hangat,
                    dan energi kecil yang perlahan berubah.
                </p>
                <p>
                    Bagi kami, setiap langkah keluar yang kami ambil memiliki satu tujuan:
                    agar lebih banyak orang bisa merasakan bahwa mereka dihargai.
                </p>

                
            </div>
        </div>

        <!-- CLOSING -->
        <div class="detail-section reveal" style="text-align:center;">
            <h3>Because Everyone Deserves Love</h3>
            <p>
                Di tengah kesibukan, selalu ada ruang untuk kebaikan.
                Dan setiap orang, tanpa terkecuali, berhak mendapatkan CINTA.
            </p>
        </div>

        <div class="detail-back reveal">
            <a asp-page="/Community" class="btn btn-secondary">← Back to Community & Outreach</a>
        </div>

    </div>
</section>