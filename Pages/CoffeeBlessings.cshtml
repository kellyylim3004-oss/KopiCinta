@page
@model KopiCinta.Pages.CoffeeBlessingsModel
@{
    ViewData["Title"] = "Coffee Blessings";
}

<section class="section">
    <div class="container">

        <div class="back-top reveal">
            <a asp-page="/Community">← Back </a>
        </div>

        <!-- HERO -->
        <div class="kbi-hero reveal">
            <div class="kbi-hero-text">
                <p class="eyebrow">Community & Outreach</p>
                <h2>Coffee Blessings</h2>
                <p>
                    Bringing CINTA, one cup at a time — a small pause, a shared moment,
                    and a reminder that everyone deserves to feel appreciated.
                </p>
            </div>

            <div class="kbi-hero-image">
                <img src="/images/CoffeeBlessings/coffee-belief-2.jpg">
            </div>
        </div>

        <!-- SECTION 1 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/CoffeeBlessings/coffee-blessings-1.jpg" class="kbi-slide active" alt="">
                <img src="/images/CoffeeBlessings/coffee-blessings-2.jpg" class="kbi-slide" alt="">
                <img src="/images/CoffeeBlessings/coffee-blessings-3.jpg" class="kbi-slide" alt="">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>We Come to You</h3>
                <p>
                    Not everyone has the time to pause.
                    Not everyone gets the chance to come and experience what we create.
                </p>
                <p>
                    So we chose to step out.
                </p>
                <p>
                    Across different corners of Malang, we find ourselves in the middle
                    of people’s everyday lives—offices, creative spaces, institutions,
                    even banks.
                </p>
                <p>
                    We don’t just come carrying coffee.
                    We come carrying something simple, yet often forgotten: <strong>CINTA</strong>.
                </p>
            </div>
        </div>

        <!-- SECTION 2 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/CoffeeBlessings/coffee-pause-1.jpg" class="kbi-slide active" alt="">
                <img src="/images/CoffeeBlessings/coffee-pause-2.jpg" class="kbi-slide" alt="">
                <img src="/images/CoffeeBlessings/coffee-pause-3.jpg" class="kbi-slide" alt="">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>A Small Pause in a Busy Day</h3>
                <p>
                    We understand that behind deadlines and responsibilities,
                    there is a kind of tiredness that often goes unseen.
                </p>
                <p>
                    Through a cup we serve directly, we’re not trying to offer something big—
                    just a small pause, a quiet moment to breathe in the middle of it all.
                </p>
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/CoffeeBlessings/coffee-belief-1.jpg" class="kbi-slide active" alt="">
                <img src="/images/CoffeeBlessings/coffee-belief-2.jpg" class="kbi-slide" alt="">
                <img src="/images/CoffeeBlessings/coffee-belief-3.jpg" class="kbi-slide" alt="">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Sharing What We Believe</h3>
                <p>
                    Every cup we share has never been just about taste.
                </p>
                <p>
                    It holds something deeper—a reflection of what we believe in,
                    and what we continue to carry in every step: <strong>CINTA</strong>.
                </p>
                <p>
                    Because we believe everyone deserves to feel appreciated,
                    no matter how small the gesture may seem.
                </p>
                <p>
                    And sometimes, something as simple as a cup of coffee
                    can gently shift the weight of a long day.
                </p>
            </div>
        </div>

        <!-- SECTION 4 -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/CoffeeBlessings/coffee-love-1.jpg" class="kbi-slide active" alt="">
                <img src="/images/CoffeeBlessings/coffee-love-2.jpg" class="kbi-slide" alt="">
                <img src="/images/CoffeeBlessings/coffee-love-3.jpg" class="kbi-slide" alt="">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>More Than Just Coffee</h3>
                <p>
                    Coffee Blessings was never just about giving.
                </p>
                <p>
                    It’s about showing up—being present, even briefly—
                    to remind someone that they are seen, that they are not alone.
                </p>
                <p>
                    In those short moments, we notice the smallest changes:
                    a smile, a lighter conversation, a softer energy.
                </p>
                <p>
                    And somehow, that feels like enough.
                </p>
            </div>
        </div>

        <!-- CLOSING -->
        <div class="detail-section reveal" style="text-align:center;">
            <h3>Because Everyone Deserves Love</h3>
            <p>
                Every step we take outside carries the same intention:
                to let more people feel that they matter.
            </p>
            <p>
                That even in the middle of a busy day,
                there is still space for kindness.
            </p>
            <p>
                And that, no matter who they are,
                everyone deserves <strong>CINTA</strong>.
            </p>
        </div>

        <div class="detail-back reveal">
            <a asp-page="/Community" class="btn btn-secondary">← Back to Community & Outreach</a>
        </div>

    </div>
</section>