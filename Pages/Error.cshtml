@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="section">
    <div class="container" style="text-align:center; max-width:720px;">

        <p class="eyebrow">Oops</p>
        <h2>Something went wrong.</h2>

        <p class="hero-text" style="margin: 0 auto 1.5rem;">
            Sorry, this page could not be loaded properly. Please try again,
            or return to the homepage.
        </p>

        @if (Model.ShowRequestId)
        {
            <p style="color: var(--muted);">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="hero-actions" style="justify-content:center;">
            <a asp-page="/Index" class="btn btn-primary">Back to Home</a>
        </div>

    </div>
</section>