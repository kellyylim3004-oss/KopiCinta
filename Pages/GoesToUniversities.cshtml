@page
@model KopiCinta.Pages.GoesToUniversitiesModel
@{
    ViewData["Title"] = "Goes to Universities";
}

<section class="section">
    <div class="container">

        <!-- BACK -->
        <div class="back-top reveal">
            <a asp-page="/Events">← Back</a>
        </div>

        <!-- HERO -->
        <div class="event-hero reveal">
            <div class="event-hero-text">
                <p class="eyebrow">Events & Engagements</p>
                <h2>Kopi Cinta Goes to Universities</h2>
                <p class="event-intro">
                    Starting with the youth — bringing deaf awareness, interaction,
                    and a new kind of experience into university spaces.
                </p>
            </div>

            <div class="event-hero-img">
                <img src="/images/universities/hero-1.jpg" alt="Kopi Cinta Goes to Universities">
            </div>
        </div>

        <!-- MAIN STORY INTRO -->
        <div class="detail-section reveal" style="max-width: 760px;">
            <h3>Starting with the Youth</h3>
            <p>
                Setiap perjalanan selalu punya titik awal. Bagi kami, langkah pertama itu dimulai
                dari kampus, tempat di mana ide tumbuh dan masa depan dibentuk.
            </p>
            <p>
                Melalui <em>Kopi Cinta Goes to Universities</em>, kami hadir di tengah momen penting:
                penerimaan mahasiswa baru.
            </p>
        </div>

        <!-- STORY GRID -->
        <div class="stories-layout reveal" style="margin-bottom: 3rem;">
            <article class="story-card large">
                <span class="story-tag">Awareness</span>
                <h3>Showing Up Where It Matters</h3>
                <p>
                    Kami membuka booth di berbagai kampus di Malang untuk berbagi CINTA
                    dan mengenalkan deaf awareness sejak awal perjalanan mereka.
                </p>
                <p>
                    Karena kami percaya, anak muda memiliki peran besar
                    dalam menciptakan perubahan.
                </p>
            </article>

            <div class="story-list">
                <article class="story-card">
                    <span class="story-tag soft">Experience</span>
                    <h3>A Different Way to Order</h3>
                    <p>
                        Mahasiswa bisa mendapatkan minuman gratis dengan satu syarat sederhana:
                        memesan menggunakan bahasa isyarat.
                    </p>
                </article>

                <article class="story-card">
                    <span class="story-tag soft">Connection</span>
                    <h3>Finding a Safe Space</h3>
                    <p>
                        Booth Kopi Cinta juga menjadi tempat singgah yang aman bagi beberapa
                        teman Tuli yang baru memulai perjalanan sebagai mahasiswa.
                    </p>
                </article>
            </div>
        </div>

        <!-- FEATURED STRIP -->
        <div class="featured-grid reveal" style="margin-bottom: 3.5rem;">
            <img src="/images/universities/hero-2.jpg" alt="">
            <img src="/images/universities/hero-3.jpg" alt="">
            <img src="/images/universities/hero-4.jpg" alt="">
        </div>

        <!-- CAMPUSES TITLE -->
        <div class="detail-section reveal" style="margin-bottom: 2rem;">
            <h3>University Highlights</h3>
            <p>
                Here are some of the campuses and spaces where Kopi Cinta brought
                the experience directly to students.
            </p>
        </div>

        <!-- JULIA FOTO -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/julia-foto-1.jpg" class="kbi-slide active" alt="Julia Foto 1">
                <img src="/images/universities/julia-foto-2.jpg" class="kbi-slide" alt="Julia Foto 2">
                <img src="/images/universities/julia-foto-3.jpg" class="kbi-slide" alt="Julia Foto 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>JULIA FOTO</h3>
                <p>
                    A campus stop that brought students into a direct and memorable
                    experience with sign language, interaction, and deaf awareness.
                </p>
            </div>
        </div>

        <!-- BINUS -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/binus-1.jpg" class="kbi-slide active" alt="BINUS 1">
                <img src="/images/universities/binus-2.jpg" class="kbi-slide" alt="BINUS 2">
                <img src="/images/universities/binus-3.jpg" class="kbi-slide" alt="BINUS 3">
                <img src="/images/universities/binus-4.jpg" class="kbi-slide" alt="BINUS 4">
                <img src="/images/universities/binus-5.jpg" class="kbi-slide" alt="BINUS 5">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>BINUS</h3>
                <p>
                    At BINUS, the booth became a meeting point for curiosity, learning,
                    and meaningful interaction through a different way of ordering and connecting.
                </p>
            </div>
        </div>

        <!-- HIPMI -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/hipmi-1.jpg" class="kbi-slide active" alt="HIPMI 1">
                <img src="/images/universities/hipmi-2.jpg" class="kbi-slide" alt="HIPMI 2">
                <img src="/images/universities/hipmi-3.jpg" class="kbi-slide" alt="HIPMI 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>HIPMI</h3>
                <p>
                    This stop extended the campaign’s reach into another youth-centered
                    environment, continuing the mission of introducing deaf awareness
                    through experience.
                </p>
            </div>
        </div>

        <!-- UM -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/um-1.jpg" class="kbi-slide active" alt="UM 1">
                <img src="/images/universities/um-2.jpg" class="kbi-slide" alt="UM 2">
                <img src="/images/universities/um-3.jpg" class="kbi-slide" alt="UM 3">
                <img src="/images/universities/um-4.jpg" class="kbi-slide" alt="UM 4">
                <img src="/images/universities/um-5.jpg" class="kbi-slide" alt="UM 5">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>UM</h3>
                <p>
                    At Universitas Negeri Malang, the experience invited students to pause,
                    learn, and interact through sign language in a way that felt approachable and warm.
                </p>
            </div>
        </div>

        <!-- UB -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/ub-1.jpg" class="kbi-slide active" alt="UB 1">
                <img src="/images/universities/ub-2.jpg" class="kbi-slide" alt="UB 2">
                <img src="/images/universities/ub-3.jpg" class="kbi-slide" alt="UB 3">
                <img src="/images/universities/ub-4.jpg" class="kbi-slide" alt="UB 4">
                <img src="/images/universities/ub-5.jpg" class="kbi-slide" alt="UB 5">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>UB</h3>
                <p>
                    At Universitas Brawijaya, the campaign continued its purpose of welcoming,
                    educating, and creating a safe and meaningful space for connection.
                </p>
            </div>
        </div>

        <!-- BACK -->
        <div class="detail-back reveal">
            <a asp-page="/Events" class="btn btn-secondary">← Back to Events</a>
        </div>

    </div>
</section>