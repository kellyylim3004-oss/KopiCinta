@page
@model KopiCinta.Pages.GoesToUniversitiesModel
@{
    ViewData["Title"] = "Goes to Universities";
}

<section class="section">
    <div class="container">

        <div class="back-top reveal">
            <a asp-page="/Events">← Back</a>
        </div>

        <!-- HERO -->
        <div class="event-hero reveal">
            <div class="event-hero-text">
                <p class="eyebrow">Events & Engagements</p>
                <h2>Kopi Cinta Goes to Universities</h2>
                <p class="event-intro">
                    Starting with the youth — bringing CINTA, Deaf awareness,
                    and sign language interaction into university spaces.
                </p>

                <div class="event-tags">
                    <span>University Visit</span>
                    <span>Deaf Awareness</span>
                    <span>Sign Language</span>
                </div>
            </div>

            <div class="event-hero-img">
                <img src="/images/universities/hero-1.jpg" alt="Kopi Cinta Goes to Universities">
            </div>
        </div>

        <!-- INTRO -->
        <div class="detail-section reveal" style="max-width: 760px;">
            <h3>Starting with the Youth</h3>
            <p>
                Every journey has a beginning. For us, that beginning started on campus—
                a place where ideas grow and futures begin to take shape.
            </p>
            <p>
                Through <em>Kopi Cinta Goes to Universities</em>, we chose to be present
                in one of the most important moments: the start of a new chapter.
            </p>
        </div>

        <!-- STORY GRID -->
        <div class="stories-layout reveal" style="margin-bottom: 3rem;">
            <article class="story-card large">
                <span class="story-tag">Awareness</span>
                <h3>Showing Up Where It Matters</h3>
                <p>
                    We opened our booth across several universities in Malang,
                    from BINUS, Universitas Negeri Malang, to Universitas Brawijaya.
                </p>
                <p>
                    In the middle of the excitement of new students, we came with one simple intention:
                    to share CINTA and introduce Deaf awareness from the very beginning.
                </p>
                <p>
                    Because we believe young people hold the power to shape change.
                </p>
            </article>

            <div class="story-list">
                <article class="story-card">
                    <span class="story-tag soft">Experience</span>
                    <h3>A Different Way to Order</h3>
                    <p>
                        Students could get a free drink by ordering using sign language,
                        with simple tutorials provided for first-time learners.
                    </p>
                </article>

                <article class="story-card">
                    <span class="story-tag soft">Connection</span>
                    <h3>Finding a Safe Space</h3>
                    <p>
                        Some Deaf students who were new to the city found comfort at our booth—
                        a place to pause, connect, and feel understood.
                    </p>
                </article>
            </div>
        </div>

        <!-- FEATURED STRIP -->
        <div class="featured-grid reveal" style="margin-bottom: 3.5rem;">
            <img src="/images/universities/hero-2.jpg" alt="">
            <img src="/images/universities/hero-3.jpg" alt="">
            <img src="/images/universities/hero-4.jpg" alt="">
        </div>

        <!-- EXPERIENCE -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/binus-1.jpg" class="kbi-slide active" alt="Students ordering with sign language">
                <img src="/images/universities/um-1.jpg" class="kbi-slide" alt="University booth interaction">
                <img src="/images/universities/ub-1.jpg" class="kbi-slide" alt="Kopi Cinta university campaign">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>A Different Way to Order</h3>
                <p>
                    Students could get a free drink with one simple step:
                    ordering using sign language.
                </p>
                <p>
                    At first, there was hesitation. Then laughter.
                    And eventually, a small sense of achievement.
                </p>
                <p>
                    We also introduced Roti Cinta, a small addition made just for that day—
                    something simple, yet enough to make the moment warmer and more memorable.
                </p>
            </div>
        </div>

        <!-- SAFE SPACE -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/ub-2.jpg" class="kbi-slide active" alt="Students at Kopi Cinta booth">
                <img src="/images/universities/um-2.jpg" class="kbi-slide" alt="Students connecting through Kopi Cinta">
                <img src="/images/universities/binus-2.jpg" class="kbi-slide" alt="Kopi Cinta university interaction">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Finding a Safe Space</h3>
                <p>
                    Amid the crowd, we found something we didn’t expect:
                    Deaf students who were new to the city and beginning their journey far from home.
                </p>
                <p>
                    In the middle of everything unfamiliar, they found comfort at our booth—
                    a place to pause, connect, and feel understood.
                </p>
                <p>
                    That was where it began for us: simple, yet full of intention.
                </p>
            </div>
        </div>

        <!-- CAMPUSES TITLE -->
        <div class="detail-section reveal" style="margin-bottom: 2rem;">
            <h3>University Highlights</h3>
            <p>
                These are some of the campuses and youth spaces where Kopi Cinta
                brought the experience directly to students.
            </p>
        </div>

        <!-- JULIA FOTO -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/julia-foto-1.jpg" class="kbi-slide active" alt="Julia Foto 1">
                <img src="/images/universities/julia-foto-2.jpg" class="kbi-slide" alt="Julia Foto 2">
                <img src="/images/universities/julia-foto-3.jpg" class="kbi-slide" alt="Julia Foto 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>JULIA FOTO</h3>
                <p>
                    A youth-centered stop that brought students into a direct and memorable
                    experience with sign language, interaction, and Deaf awareness.
                </p>
            </div>
        </div>

        <!-- BINUS -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/binus-1.jpg" class="kbi-slide active" alt="BINUS 1">
                <img src="/images/universities/binus-2.jpg" class="kbi-slide" alt="BINUS 2">
                <img src="/images/universities/binus-3.jpg" class="kbi-slide" alt="BINUS 3">
                <img src="/images/universities/binus-4.jpg" class="kbi-slide" alt="BINUS 4">
                <img src="/images/universities/binus-5.jpg" class="kbi-slide" alt="BINUS 5">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>BINUS</h3>
                <p>
                    At BINUS, the booth became a meeting point for curiosity, learning,
                    and meaningful interaction through a different way of ordering and connecting.
                </p>
            </div>
        </div>

        <!-- HIPMI -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/hipmi-1.jpg" class="kbi-slide active" alt="HIPMI 1">
                <img src="/images/universities/hipmi-2.jpg" class="kbi-slide" alt="HIPMI 2">
                <img src="/images/universities/hipmi-3.jpg" class="kbi-slide" alt="HIPMI 3">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>HIPMI</h3>
                <p>
                    This stop extended the campaign into another youth-centered environment,
                    continuing the mission of introducing Deaf awareness through experience.
                </p>
            </div>
        </div>

        <!-- UM -->
        <div class="kbi-section reverse reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/um-1.jpg" class="kbi-slide active" alt="UM 1">
                <img src="/images/universities/um-2.jpg" class="kbi-slide" alt="UM 2">
                <img src="/images/universities/um-3.jpg" class="kbi-slide" alt="UM 3">
                <img src="/images/universities/um-4.jpg" class="kbi-slide" alt="UM 4">
                <img src="/images/universities/um-5.jpg" class="kbi-slide" alt="UM 5">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Universitas Negeri Malang</h3>
                <p>
                    At UM, the experience invited students to pause, learn,
                    and interact through sign language in a way that felt approachable and warm.
                </p>
            </div>
        </div>

        <!-- UB -->
        <div class="kbi-section reveal">
            <div class="kbi-slider" data-kbi-slider>
                <img src="/images/universities/ub-1.jpg" class="kbi-slide active" alt="UB 1">
                <img src="/images/universities/ub-2.jpg" class="kbi-slide" alt="UB 2">
                <img src="/images/universities/ub-3.jpg" class="kbi-slide" alt="UB 3">
                <img src="/images/universities/ub-4.jpg" class="kbi-slide" alt="UB 4">
                <img src="/images/universities/ub-5.jpg" class="kbi-slide" alt="UB 5">

                <button type="button" class="kbi-slide-btn prev" data-prev>‹</button>
                <button type="button" class="kbi-slide-btn next" data-next>›</button>
            </div>

            <div class="kbi-text">
                <h3>Universitas Brawijaya</h3>
                <p>
                    At UB, the campaign continued its purpose of welcoming,
                    educating, and creating a safe and meaningful space for connection.
                </p>
            </div>
        </div>

        <!-- CLOSING -->
        <div class="hbii-ending reveal">
            <h3>CINTA Finds Its Way</h3>
            <p>
                Because in the end, CINTA always finds its way —
                even in places that are entirely new.
            </p>
        </div>

        <br />

        <div class="detail-back reveal">
            <a asp-page="/Events" class="btn btn-secondary">← Back to Events</a>
        </div>

    </div>
</section>