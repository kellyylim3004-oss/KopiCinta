@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<section class="kc-story-hero"> <div class="kc-scroll-stage"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/coffee-bean.png" class="kc-flow-item"> <img src="/images/HOME/envelope.png" class="kc-envelope"> <img src="/images/HOME/envelope-closed.png" class="kc-envelope-closed"> <img src="/images/HOME/mailbox.png" class="kc-mailbox"> <img src="/images/HOME/world-map.png" class="kc-world"> </div> </section>

<section class="section intro-band">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">What We Do</p>
            <h2>Things we do that do things to us</h2>
            <p>
                Through coffee, sign language, and community experiences, Kopi Cinta creates
                simple but meaningful ways for Deaf and hearing people to meet, learn, and connect.
            </p>
        </div>

        <div class="intro-grid">
            <article class="intro-card reveal">
                <span>01</span>
                <h3>Workshops & Learning</h3>
                <p>
                    Learn sign language and Deaf awareness through warm, beginner-friendly experiences.
                </p>
                <a asp-page="/Workshops" class="text-link">Explore workshops →</a>
            </article>

            <article class="intro-card reveal">
                <span>02</span>
                <h3>Community & Outreach</h3>
                <p>
                    Discover initiatives built around kindness, access, and meaningful social impact.
                </p>
                <a asp-page="/Community" class="text-link">See outreach →</a>
            </article>

            <article class="intro-card reveal">
                <span>03</span>
                <h3>Collaborations & Campaigns</h3>
                <p>
                    Explore partnerships, campaigns, and shared projects that spread CINTA further.
                </p>
                <a asp-page="/Collaborations" class="text-link">View collaborations →</a>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="kbi-section reveal">
            <div class="kbi-hero-image">
                <img src="/images/HOME/FOTO KOPCIN-23.jpg" alt="Coffee being poured">
            </div>

            <div class="kbi-text">
                <p class="eyebrow">Coffee Experience</p>
                <h3>Coffee, Conversation, and Connection</h3>
                <p>
                    At Kopi Cinta, coffee is not only served for taste. It becomes a way to start conversations,
                    create comfort, and introduce people to a more inclusive way of connecting.
                </p>
                <p>
                    From live coffee experiences to Deaf-led interactions, every small detail carries a story.
                </p>
                <a asp-page="/Workshops" class="text-link">See coffee experiences →</a>
            </div>
        </div>

        <div class="kbi-section reverse reveal">
            <div class="kbi-hero-image">
                <img src="/images/HOME/FOTO KOPCIN-40.jpg" alt="Kopi Cinta team with coffee">
            </div>

            <div class="kbi-text">
                <p class="eyebrow">Our Story</p>
                <h3>Built from love proven through action</h3>
                <p>
                    Kopi Cinta began from a simple belief: people with disabilities do not have different dreams,
                    they just do not always receive the same access.
                </p>
                <p>
                    That belief continues to guide every workshop, campaign, story, and cup we share.
                </p>
                <a asp-page="/About" class="text-link">Read about us →</a>
            </div>
        </div>
    </div>
</section>

<section class="section intro-band">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Explore Kopi Cinta</p>
            <h2 style="white-space: nowrap;">Choose where your journey begins.</h2>
        </div>

        <div class="stories-layout">
            <article class="story-card large reveal">
                <div class="story-tag">Featured</div>
                <h3>Learn BISINDO sign language </h3>
                <p>
                    Visit the Sign Center to explore sign language topics, alphabet learning,
                    and interactive features made to help more people communicate with confidence.
                </p>
                <p class="small-note">
                    *Every sign language is different around the world.
                </p>
                <a asp-page="/Dictionary" class="text-link">Dictionary →</a>
            </article>

            <div class="story-list">
                <article class="story-card reveal">
                    <div class="story-tag soft">Stories</div>
                    <h3>
                        Meet the people behind <br>
                        Kopi Cinta
                    </h3>                    <p>
                        Read reflections from the team and discover the personal meaning behind this journey.
                    </p>
                    <a asp-page="/Team" class="text-link">Read more</a>
                </article>

                <article class="story-card reveal">
                    <div class="story-tag soft">Experiences</div>
                    <h3>Explore our programs and events</h3>
                    <p>
                        From community outreach to university booths, each experience is made to spread awareness.
                    </p>
                    <a asp-page="/Projects" class="text-link">Explore experiences</a>
                </article>

                <article class="story-card reveal">
                    <div class="story-tag soft">Game</div>
                    <h3>Win and have fun !</h3>
                    <p>
                        Try the interactive game and collect signs while learning in a fun, memorable way.
                    </p>
                    <a asp-page="/Game" class="text-link">Kopi Cinta Runner</a>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="section memories-section">
    <div class="container">

        <div class="section-head reveal">
            <p class="eyebrow">Wall of Memories</p>
            <h2>Moments shared through coffee, stories, and CINTA.</h2>
        </div>

        <div class="memories-grid reveal">

            <img src="/images/HOME/memory-1.jpg" alt="Kopi Cinta memory">
            <img src="/images/HOME/memory-2.jpg" alt="Kopi Cinta memory">
            <img src="/images/HOME/memory-3.jpg" alt="Kopi Cinta memory">
            <img src="/images/HOME/memory-4.jpg" alt="Kopi Cinta memory">
            <img src="/images/HOME/memory-5.jpg" alt="Kopi Cinta memory">

        </div>

    </div>
</section>

<section class="section">
    <div class="container">
        <div class="hero-card reveal" style="width:100%; max-width:none;">
            <span class="pill">Get Involved</span>
            <h3>Let’s create more inclusive experiences together.</h3>
            <p>
                Kopi Cinta welcomes schools, communities, brands, coffee spaces, and organizations
                that want to support Deaf awareness through meaningful collaboration.
            </p>

            <div class="hero-actions" style="margin-top:1.25rem;">
                <a class="btn btn-primary" asp-page="/Contact">Work With Us</a>
                <a class="btn btn-secondary" asp-page="/Collaborations">See Collaborations</a>
            </div>
        </div>
    </div>
</section>
<style>
    .kc-story-hero {
        height: 260vh;
        background: #f5f0ed;
        overflow: hidden;
        position: relative;
    }

    .kc-scroll-stage {
        position: sticky;
        top: 72px;
        height: calc(100vh - 72px);
        overflow: visible;
    }

    .kc-flow-item {
        position: absolute;
        width: 60px;
        z-index: 40;
        left: 50%;
        top: 50%;
        transform-origin: center;
        transition: none;
        filter: drop-shadow(0 10px 16px rgba(0,0,0,.12));
    }

    .kc-envelope, .kc-envelope-closed {
        position: absolute;
        width: 500px;
        left: 50%;
        top: 70%;
        transform: translate(-50%, -50%) scale(.7);
        opacity: 0;
        transition: none;
        filter: drop-shadow(0 18px 30px rgba(0,0,0,.16));
    }

    .kc-envelope {
        z-index: 20;
    }

    .kc-envelope-closed {
        z-index: 25;
    }

    .kc-mailbox {
        position: absolute;
        width: 420px;
        left: 50%;
        top: 68%;
        transform: translate(-50%, -50%) scale(.7);
        opacity: 0;
        z-index: 30;
        transition: none;
        filter: drop-shadow(0 18px 30px rgba(0,0,0,.16));
    }

    .kc-world {
        position: absolute;
        width: 420px;
        left: 50%;
        bottom: 20px;
        transform: translateX(-50%) scale(.85);
        opacity: 0;
        z-index: 5;
        transition: none;
    }

    @@media (max-width:768px) {
        .kc-story-hero {
            height: 240vh;
        }

        .kc-flow-item {
            width: 42px;
        }

        .kc-envelope, .kc-envelope-closed {
            width: 300px;
            top: 68%;
        }

        .kc-mailbox {
            width: 260px;
            top: 68%;
        }

        .kc-world {
            width: 240px;
        }
    }
</style>
<script>document.addEventListener("DOMContentLoaded", () => { const hero = document.querySelector(".kc-story-hero"); const items = document.querySelectorAll(".kc-flow-item"); const envelope = document.querySelector(".kc-envelope"); const closedEnvelope = document.querySelector(".kc-envelope-closed"); const mailbox = document.querySelector(".kc-mailbox"); const world = document.querySelector(".kc-world"); const startX = [-720, -580, -430, -280, -130, 0, 130, 280, 430, 580, 720, -20]; const startY = [-260, -120, -200, 20, -180, -60, -140, 40, -170, -90, -240, 80]; const endX = [-35, -28, -22, -15, -8, 0, 8, 15, 22, 28, 35, 0]; const endY = [145, 155, 135, 165, 150, 140, 150, 165, 135, 155, 145, 175]; const rotate = [-120, 95, -80, 65, -45, 30, -30, 45, -65, 80, -95, 120]; function clamp(value, min, max) { return Math.min(Math.max(value, min), max); } function animateHero() { const rect = hero.getBoundingClientRect(); const progress = clamp(-rect.top / (rect.height - window.innerHeight), 0, 1); const envelopeIn = clamp((progress - 0.08) / 0.15, 0, 1); const beanProgress = clamp(progress / 0.50, 0, 1); const beanFade = clamp((progress - 0.50) / 0.10, 0, 1); const closedIn = clamp((progress - 0.60) / 0.10, 0, 1); const mailboxIn = clamp((progress - 0.72) / 0.10, 0, 1); const worldIn = clamp((progress - 0.84) / 0.10, 0, 1); envelope.style.opacity = envelopeIn * (1 - closedIn); envelope.style.transform = `translate(-50%, -50%) scale(${0.7 + envelopeIn * 0.3})`; items.forEach((item, i) => { const x = startX[i] + (endX[i] - startX[i]) * beanProgress; const y = startY[i] + (endY[i] - startY[i]) * beanProgress; const r = rotate[i] * (1 - beanProgress); const scale = 1 - beanProgress * 0.35; item.style.transform = `translate(${x}px, ${y}px) rotate(${r}deg) scale(${scale})`; item.style.opacity = 1 - beanFade; }); closedEnvelope.style.opacity = closedIn * (1 - mailboxIn); closedEnvelope.style.transform = `translate(-50%, -50%) scale(${0.7 + closedIn * 0.3})`; mailbox.style.opacity = mailboxIn; mailbox.style.transform = `translate(-50%, -50%) scale(${0.7 + mailboxIn * 0.25})`; world.style.opacity = worldIn; world.style.transform = `translateX(-50%) scale(${0.85 + worldIn * 0.15})`; } animateHero(); window.addEventListener("scroll", animateHero); window.addEventListener("resize", animateHero); });</script>