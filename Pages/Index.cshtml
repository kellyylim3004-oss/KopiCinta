        height: 85px;
        left: 105px;
        top: 60px;
    }

    .arrow-3 {
        width: 85px;
        height: 100px;
        left: 145px;
        top: 70px;
    }

    .arrow-4 {
        width: 100px;
        height: 85px;
        left: 200px;
        top: 60px;
    }

    .arrow-5 {
        width: 125px;
        height: 85px;
        left: 220px;
        top: 45px;
    }
}
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const hero = document.querySelector(".kc-story-hero");
        if (!hero) return;

        const items = document.querySelectorAll(".kc-flow-item");
        const envelope = document.querySelector(".kc-envelope");
        const closedEnvelope = document.querySelector(".kc-envelope-closed");
        const mailbox = document.querySelector(".kc-mailbox");
        const world = document.querySelector(".kc-world");

        const startX = [
            -760, -620, -500, -360,
            -220, -80, 80, 220,
            360, 500, 640, 760
        ];

        const startY = [
            -170, 90, -120, 140,
            -60, 110, -90, 150,
            -40, 120, -100, 70
        ];

        const endX = [-260, -230, -205, -178, -150, -222, -195, -165, -138, -112, -88, -185];
        const endY = [-95, -82, -112, -88, -105, -58, -70, -62, -78, -92, -66, -48];

        const rotate = [-14, 9, -12, 10, -7, 13, -9, 7, -10, 12, -13, 5];

        function clamp(v, min, max) {
            return Math.min(Math.max(v, min), max);
        }

        function fadeInOut(progress, start, end, outStart, outEnd) {
            const fadeIn = clamp((progress - start) / (end - start), 0, 1);
            const fadeOut = 1 - clamp((progress - outStart) / (outEnd - outStart), 0, 1);
            return fadeIn * fadeOut;
        }

        function animateHero() {
            const rect = hero.getBoundingClientRect();
            const progress = clamp(-rect.top / (rect.height - window.innerHeight), 0, 1);

            const itemMove = clamp(progress / 0.30, 0, 1);
            const itemFade = clamp((progress - 0.37) / 0.10, 0, 1);

            const openEnvelopeOpacity = fadeInOut(progress, 0.06, 0.16, 0.42, 0.50);
            const closedOpacity = fadeInOut(progress, 0.48, 0.58, 0.66, 0.74);
            const closedDrop = clamp((progress - 0.55) / 0.14, 0, 1);

            const mailboxOpacity = clamp((progress - 0.66) / 0.10, 0, 1);
            const worldOpacity = clamp((progress - 0.76) / 0.12, 0, 1);

            envelope.style.opacity = openEnvelopeOpacity;
            envelope.style.transform =
                `translate(-50%, -50%) scale(${0.78 + openEnvelopeOpacity * 0.22})`;

            closedEnvelope.style.opacity = closedOpacity;
            closedEnvelope.style.transform =
                `translate(-50%, ${-50 + closedDrop * 28}%) scale(${0.78 - closedDrop * 0.10}) rotate(${closedDrop * 4}deg)`;

            mailbox.style.opacity = mailboxOpacity;
            mailbox.style.transform =
                `translate(-50%, -50%) scale(${0.78 + mailboxOpacity * 0.22})`;

            world.style.opacity = worldOpacity;
            world.style.transform =
                `translate(-50%, -50%) scale(${0.85 + worldOpacity * 0.15})`;

            items.forEach((item, i) => {
                const x = startX[i] + (endX[i] - startX[i]) * itemMove;
                const y = startY[i] + (endY[i] - startY[i]) * itemMove;
                const r = rotate[i] * (1 - itemMove);
                const scale = 1 - itemMove * 0.08;

                item.style.transform = `translate(${x}px, ${y}px) rotate(${r}deg) scale(${scale})`;
                item.style.opacity = 1 - itemFade;
            });
        }

        animateHero();
        window.addEventListener("scroll", animateHero);
        window.addEventListener("resize", animateHero);
    });
</script>