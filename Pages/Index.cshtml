@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<section class="kc-story-hero">
    <div class="kc-scroll-stage">

        <div class="kc-big-message">
            <h1>
                <span class="script-word">Sharing</span>

                <span class="block-word">
                    DEAF
                </span>

                <span class="script-word awareness-word">
                    Awareness
                </span>
            </h1>

            <p>
                one person, one experience,<br>
                and one community at a time.
            </p>
        </div>

        <img src="/images/HOME/coffee-bean.png" class="kc-flow-item bean">
        <img src="/images/HOME/logo-kopi-cinta.png" class="kc-flow-item logo-kc">
        <img src="/images/HOME/normal-person1.png" class="kc-flow-item normal-person">
        <img src="/images/HOME/hand-v2.png" class="kc-flow-item hand">

        <img src="/images/HOME/cup.png" class="kc-flow-item cup">
        <img src="/images/HOME/sign-person1.png" class="kc-flow-item sign-person">
        <img src="/images/HOME/logo-kopi-cinta.png" class="kc-flow-item logo-kc">
        <img src="/images/HOME/coffee-bean.png" class="kc-flow-item bean">

        <img src="/images/HOME/normal-person2.png" class="kc-flow-item normal-person">
        <img src="/images/HOME/cup.png" class="kc-flow-item cup">
        <img src="/images/HOME/hand-v2.png" class="kc-flow-item hand">
        <img src="/images/HOME/logo-kopi-cinta.png" class="kc-flow-item logo-kc">

        <img src="/images/HOME/sign-person2.png" class="kc-flow-item sign-person">
        <img src="/images/HOME/normal-person3.png" class="kc-flow-item normal-person">
        <img src="/images/HOME/sign-person3.png" class="kc-flow-item sign-person">

        <img src="/images/HOME/envelope.png" class="kc-envelope">
        <img src="/images/HOME/envelope-closed1.png" class="kc-envelope-closed">
        <img src="/images/HOME/mailbox.png" class="kc-mailbox">
        <img src="/images/HOME/world-map.png" class="kc-world">
    </div>
</section>
    
<section class="section intro-band home-things-section">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">What We Do</p>
            <h2 class="desktop-one-line">
                Things we do that do things to us
            </h2>
            <p>
                Through coffee, sign language, and community experiences, Kopi Cinta creates
                simple but meaningful ways for Deaf and hearing people to meet, learn, and connect.
            </p>
        </div>

        <div class="intro-grid">
            <article class="intro-card reveal">
                <span>01</span>
                <h3>Workshops & Learning</h3>
                <p>
                    Learn sign language and Deaf awareness through warm, beginner-friendly experiences.
                </p>
                <a asp-page="/Workshops" class="text-link">Explore workshops →</a>
            </article>

            <article class="intro-card reveal">
                <span>02</span>
                <h3>Community & Outreach</h3>
                <p>
                    Discover initiatives built around kindness, access, and meaningful social impact.
                </p>
                <a asp-page="/Community" class="text-link">See outreach →</a>
            </article>

            <article class="intro-card reveal">
                <span>03</span>
                <h3>Collaborations & Campaigns</h3>
                <p>
                    Explore partnerships, campaigns, and shared projects that spread CINTA further.
                </p>
                <a asp-page="/Collaborations" class="text-link">View collaborations →</a>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="kbi-section reveal">
            <div class="kbi-hero-image">
                <img src="/images/HOME/FOTO KOPCIN-23.jpg" alt="Coffee being poured">
            </div>

            <div class="kbi-text">
                <p class="eyebrow">Coffee Experience</p>
                <h3>Coffee, Conversation, and Connection</h3>
                <p>
                    At Kopi Cinta, coffee is not only served for taste. It becomes a way to start conversations,
                    create comfort, and introduce people to a more inclusive way of connecting.
                </p>
                <p>
                    From live coffee experiences to Deaf-led interactions, every small detail carries a story.
                </p>
                <a asp-page="/Workshops" class="text-link">See coffee experiences →</a>
            </div>
        </div>

        <div class="kbi-section reverse reveal">
            <div class="kbi-hero-image">
                <img src="/images/HOME/FOTO KOPCIN-40.jpg" alt="Kopi Cinta team with coffee">
            </div>

            <div class="kbi-text">
                <p class="eyebrow">Our Story</p>
                <h3>Built from love proven through action</h3>
                <p>
                    Kopi Cinta began from a simple belief: people with disabilities do not have different dreams,
                    they just do not always receive the same access.
                </p>
                <p>
                    That belief continues to guide every workshop, campaign, story, and cup we share.
                </p>
                <a asp-page="/About" class="text-link">Read about us →</a>
            </div>
        </div>
    </div>
</section>

<section class="section intro-band">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Explore Kopi Cinta</p>
            <h2 class="desktop-one-line">
                Choose where your journey begins.
            </h2>
        </div>

        <div class="stories-layout">
            <article class="story-card large reveal">
                <div class="story-tag">Featured</div>
                <h3>Learn BISINDO sign language </h3>
                <p>
                    Visit the Sign Center to explore sign language topics, alphabet learning,
                    and interactive features made to help more people communicate with confidence.
                </p>
                <p class="small-note">
                    *Every sign language is different around the world.
                </p>
                <a asp-page="/Dictionary" class="text-link">Dictionary →</a>
            </article>

            <div class="story-list">
                <article class="story-card reveal">
                    <div class="story-tag soft">Stories</div>
                    <h3>
                        Meet the people behind <br>
                        Kopi Cinta
                    </h3>                    <p>
                        Read reflections from the team and discover the personal meaning behind this journey.
                    </p>
                    <a asp-page="/Team" class="text-link">Read more</a>
                </article>

                <article class="story-card reveal">
                    <div class="story-tag soft">Experiences</div>
                    <h3>Explore our programs and events</h3>
                    <p>
                        From community outreach to university booths, each experience is made to spread awareness.
                    </p>
                    <a asp-page="/Projects" class="text-link">Explore experiences</a>
                </article>

                <article class="story-card reveal">
                    <div class="story-tag soft">Game</div>
                    <h3>Win and have fun !</h3>
                    <p>
                        Try the interactive game and collect signs while learning in a fun, memorable way.
                    </p>
                    <a asp-page="/Game" class="text-link">Kopi Cinta Runner</a>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="section memories-section">
    <div class="container">

        <div class="section-head reveal">
            <p class="eyebrow">Wall of Memories</p>
            <h2>Moments shared through coffee, stories, and CINTA.</h2>
        </div>

        <div class="memories-grid reveal">

            <img src="/images/HOME/memory-1.jpg" alt="Kopi Cinta memory">
            <img src="/images/HOME/memory-2.jpg" alt="Kopi Cinta memory">
            <img src="/images/HOME/memory-3.jpg" alt="Kopi Cinta memory">
            <img src="/images/HOME/memory-4.jpg" alt="Kopi Cinta memory">
            <img src="/images/HOME/memory-5.jpg" alt="Kopi Cinta memory">

        </div>

    </div>
</section>

<section class="section">
    <div class="container">
        <div class="hero-card reveal" style="width:100%; max-width:none;">
            <span class="pill">Get Involved</span>
            <h3>Let’s create more inclusive experiences together.</h3>
            <p>
                Kopi Cinta welcomes schools, communities, brands, coffee spaces, and organizations
                that want to support Deaf awareness through meaningful collaboration.
            </p>

            <div class="hero-actions" style="margin-top:1.25rem;">
                <a class="btn btn-primary" asp-page="/Contact">Work With Us</a>
                <a class="btn btn-secondary" asp-page="/Collaborations">See Collaborations</a>
            </div>
        </div>
    </div>
</section>
<style>
    .kc-story-hero {
        height: 760vh !important;
        background: #f5f0ed !important;
        overflow: visible !important;
        position: relative !important;
        z-index: 1 !important;
        padding-bottom: 600px;
    }

    .kc-scroll-stage {
        position: sticky !important;
        top: 0 !important;
        height: 135vh !important;
        overflow: visible !important;
        padding-bottom: 600px;
    }

    .kc-big-message {
    position: absolute !important;

    top: 6% !important;
    left: 5% !important;

    z-index: 20 !important;

    pointer-events: none !important;

    text-align: left !important;

    opacity: 1 !important;

    transform: none !important;
}

.kc-big-message h1 {
    margin: 0;

    display: flex;
    flex-direction: column;

    line-height: .85;
}

.kc-big-message .script-word {
    font-family: "Pacifico", cursive;

    font-size: clamp(3.5rem, 7vw, 6rem);

    color: var(--red);

    font-weight: 400;

    letter-spacing: .5px;

    text-shadow:
        2px 2px 0 rgba(42,35,33,.12);
}

.kc-big-message .block-word {
    font-family: "Raleway", sans-serif;

    font-size: clamp(4rem, 8vw, 7rem);

    font-weight: 800;

    letter-spacing: -4px;

    color: var(--red);

    text-shadow:
        3px 3px 0 rgba(42,35,33,.18);
}

.kc-big-message .awareness-word {
    margin-top: -.2rem;
}

.kc-big-message p {
    margin-top: 1rem;

    font-family: "Poppins", sans-serif;

    font-size: clamp(1rem, 1.4vw, 1.2rem);

    color: #7b5b55;

    font-weight: 500;

    line-height: 1.45;

    max-width: 420px;
}

@@media (max-width:768px) {

    .kc-big-message {
        top: 9% !important;
        left: 6% !important;
    }

    .kc-big-message .script-word {
        font-size: clamp(2.6rem, 11vw, 4rem);
    }

    .kc-big-message .block-word {
        font-size: clamp(3rem, 13vw, 5rem);

        letter-spacing: -2px;
    }

    .kc-big-message p {
        font-size: .95rem;

        max-width: 260px;
    }
}

    .kc-flow-item {
        position: absolute !important;
        left: 50% !important;
        top: 38% !important;
        z-index: 160 !important;
        opacity: 1;
        transform-origin: center !important;
        transition: none !important;
        filter: drop-shadow(0 10px 16px rgba(0,0,0,.12)) !important;
    }

        .kc-flow-item.bean {
            width: 125px !important;
        }

        .kc-flow-item.hand {
            width: 145px !important;
        }

        .kc-flow-item.cup {
            width: 165px !important;
        }

        .kc-flow-item.normal-person,
        .kc-flow-item.sign-person {
            width: 290px !important;
        }

        .kc-flow-item.logo-kc {
            width: 170px !important;
        }

    .kc-envelope,
    .kc-envelope-closed,
    .kc-mailbox,
    .kc-world {
        position: absolute !important;
        display: block !important;
        pointer-events: none !important;
        transition: none !important;
    }

    .kc-envelope,
    .kc-envelope-closed {
        width: 560px !important;
        left: 50% !important;
        top: 58% !important;
        opacity: 0;
        transform: translate(-50%, -50%) scale(.78);
        filter: drop-shadow(0 18px 30px rgba(0,0,0,.16)) !important;
    }

    .kc-envelope {
        z-index: 100 !important;
    }

    .kc-envelope-closed {
        z-index: 150 !important;
    }

    .kc-mailbox {
        width: 280px !important;
        left: 50% !important;
        top: 72% !important;
        opacity: 0;
        z-index: 170 !important;
        transform: translate(-50%, -50%) scale(.78);
        filter: drop-shadow(0 18px 30px rgba(0,0,0,.18)) !important;
    }

    .kc-world {
        width: 1050px !important;
        left: 50% !important;
        top: 112% !important;
        opacity: 0;
        z-index: 90 !important;
        transform: translate(-50%, -50%) scale(.85);
    }

    .home-things-section {
        margin-top: -220px !important;
        padding-top: 260px !important;
        position: relative !important;
        z-index: 5 !important;
    }

    @@media (max-width:768px) {
        .kc-big-message {
            top: 10% !important;
            left: 6% !important;
        }

            .kc-big-message h1 {
                font-size: clamp(2.8rem, 13vw, 5rem);
                letter-spacing: -2px;
                line-height: .9;
            }

            .kc-big-message p {
                font-size: .95rem;
                max-width: 260px;
            }

        .kc-flow-item.bean {
            width: 58px !important;
        }

        .kc-flow-item.hand {
            width: 68px !important;
        }

        .kc-flow-item.cup {
            width: 78px !important;
        }

        .kc-flow-item.normal-person,
        .kc-flow-item.sign-person {
            width: 125px !important;
        }

        .kc-flow-item.logo-kc {
            width: 78px !important;
        }

        .kc-envelope,
        .kc-envelope-closed {
            width: 280px !important;
            top: 56% !important;
        }

        .kc-mailbox {
            width: 200px !important;
            top: 72% !important;
        }

        .kc-world {
            width: 330px !important;
            top: 112% !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const hero = document.querySelector(".kc-story-hero");
        if (!hero) return;

        const items = document.querySelectorAll(".kc-flow-item");
        const envelope = document.querySelector(".kc-envelope");
        const closedEnvelope = document.querySelector(".kc-envelope-closed");
        const mailbox = document.querySelector(".kc-mailbox");
        const world = document.querySelector(".kc-world");
        const bigMessage = document.querySelector(".kc-big-message");

        const startX = [
            -520, -300, -120, 180,
            420, -640, -380, -40,
            260, 560, -500, -180,
            120, 380, 700
        ];

        const startY = [
            -260, -120, -320, -180,
            -40, 120, 260, 180,
            320, 140, -60, 80,
            -140, 40, -220
        ];

        const endX = [
            -230, -190, -155, -120,
            -85, -205, -170, -135,
            -100, -65, -30, -175,
            -140, -105, -55
        ];

        const endY = [
            -72, -54, -84, -62,
            -78, -30, -44, -34,
            -48, -64, -38, -14,
            -56, -40, -70
        ];

        const rotate = [
            -14, 9, -12, 10,
            -7, 13, -9, 7,
            -10, 12, -13, 5,
            -8, 11, -6
        ];

        function clamp(v, min, max) {
            return Math.min(Math.max(v, min), max);
        }

        function fadeInOut(progress, start, end, outStart, outEnd) {
            const fadeIn = clamp((progress - start) / (end - start), 0, 1);
            const fadeOut = 1 - clamp((progress - outStart) / (outEnd - outStart), 0, 1);
            return fadeIn * fadeOut;
        }

        function animateHero() {
            const rect = hero.getBoundingClientRect();
            const progress = clamp(-rect.top / (rect.height - window.innerHeight), 0, 1);

            const itemMove = clamp(progress / 0.30, 0, 1);
            const itemFade = clamp((progress - 0.37) / 0.10, 0, 1);

            const messageOpacity = 1;

            const openEnvelopeOpacity = fadeInOut(progress, 0.06, 0.16, 0.42, 0.50);
            const closedOpacity = fadeInOut(progress, 0.48, 0.58, 0.66, 0.74);
            const closedDrop = clamp((progress - 0.55) / 0.14, 0, 1);

            const mailboxOpacity = clamp((progress - 0.66) / 0.10, 0, 1);
            const worldOpacity = clamp((progress - 0.76) / 0.12, 0, 1);

            bigMessage.style.opacity = messageOpacity;
            bigMessage.style.transform = `translateY(0)`;

            envelope.style.opacity = openEnvelopeOpacity;
            envelope.style.transform =
                `translate(-50%, -50%) scale(${0.78 + openEnvelopeOpacity * 0.22})`;

            closedEnvelope.style.opacity = closedOpacity;
            closedEnvelope.style.transform =
                `translate(-50%, ${-50 + closedDrop * 28}%) scale(${0.78 - closedDrop * 0.10}) rotate(${closedDrop * 4}deg)`;

            mailbox.style.opacity = mailboxOpacity;
            mailbox.style.transform =
                `translate(-50%, -50%) scale(${0.78 + mailboxOpacity * 0.22})`;

            world.style.opacity = worldOpacity;
            world.style.transform =
                `translate(-50%, -50%) scale(${0.85 + worldOpacity * 0.15})`;

            items.forEach((item, i) => {
                const x = startX[i] + (endX[i] - startX[i]) * itemMove;
                const y = startY[i] + (endY[i] - startY[i]) * itemMove;
                const r = rotate[i] * (1 - itemMove);
                const scale = 1 - itemMove * 0.08;

                item.style.transform = `translate(${x}px, ${y}px) rotate(${r}deg) scale(${scale})`;
                item.style.opacity = 1 - itemFade;
            });
        }

        animateHero();
        window.addEventListener("scroll", animateHero);
        window.addEventListener("resize", animateHero);
    });
</script>