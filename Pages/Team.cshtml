@page
@model KopiCinta.Pages.TeamModel
@{
    ViewData["Title"] = "Our Team";
}

<section class="section">
    <div class="container">

        <!-- HERO -->
        <div class="tt-hero reveal">
            <p class="eyebrow">About</p>
            <h2>Meet the People Behind Kopi Cinta</h2>
            <p class="tt-intro">
                Behind every cup, every conversation, and every shared experience,
                there are people who continue to learn, grow, and build connection together.
            </p>
        </div>

        <!-- TEAM GRID -->
        <div class="exp-grid team-grid">

            <!-- Audrey -->
            <a asp-page="/TeamAudrey" class="exp-card-lg reveal team-card">
                <img src="/images/team/audrey.jpg" class="team-img" alt="Audrey Sierends">
                <div class="exp-card-content">
                    <h3>Audrey Sierends</h3>
                    <p><strong>F&amp;B Entrepreneur</strong></p>
                    <p>
                        Audrey builds with purpose—turning business into a platform for impact,
                        where empathy, opportunity, and connection come together.
                    </p>
                    <span class="exp-readmore">View Profile</span>
                </div>
            </a>

            <!-- Ardisa -->
            <a asp-page="/TeamArdisa" class="exp-card-lg reveal team-card">
                <img src="/images/team/ardisa.jpg" class="team-img" alt="Ardisa Faras Dewi">
                <div class="exp-card-content">
                    <h3>Ardisa Faras Dewi</h3>
                    <p><strong>Deaf Barista</strong></p>
                    <p>
                        Ardisa began her journey with Kopi Cinta through barista training,
                        and gradually found more than just work—a meaningful space to learn,
                        adapt, and grow.
                    </p>
                    <span class="exp-readmore">View Profile</span>
                </div>
            </a>

            <!-- Alif -->
            <a asp-page="/TeamAlif" class="exp-card-lg reveal team-card">
                <img src="/images/team/alif.jpg" class="team-img" alt="Alif">
                <div class="exp-card-content">
                    <h3>Alif</h3>
                    <p><strong>Latte Art Enthusiast</strong></p>
                    <p>
                        For Alif, coffee has always been familiar, but Kopi Cinta became
                        the space where he could deepen his craft, especially in latte art,
                        while continuing to improve his service and communication.
                    </p>
                    <span class="exp-readmore">View Profile</span>
                </div>
            </a>

            <!-- Axel -->
            <a asp-page="/TeamAxel" class="exp-card-lg reveal team-card">
                <img src="/images/team/axel.jpg" class="team-img" alt="Axel Marcellino Antonio">
                <div class="exp-card-content">
                    <h3>Axel Marcellino Antonio</h3>
                    <p><strong>The Prankster of the Group</strong></p>
                    <p>
                        Since joining in 2023, Axel has grown through his work in the bar,
                        popcorn, and cotton candy stations—bringing both service and joyful
                        moments into the experience.
                    </p>
                    <span class="exp-readmore">View Profile</span>
                </div>
            </a>

            <!-- Nanda -->
            <a asp-page="/TeamNanda" class="exp-card-lg reveal team-card">
                <img src="/images/team/nanda.jpg" class="team-img" alt="Nanda">
                <div class="exp-card-content">
                    <h3>Nanda</h3>
                    <p><strong>The Golden Hand</strong></p>
                    <p>
                        Nanda joined Kopi Cinta with prior barista experience and found
                        a place where quality, sincerity, and meaningful service could
                        come together in one space.
                    </p>
                    <span class="exp-readmore">View Profile</span>
                </div>
            </a>

            <!-- Safa -->
            <a asp-page="/TeamSafa" class="exp-card-lg reveal team-card">
                <img src="/images/team/safa.jpg" class="team-img" alt="Safa Adhisya">
                <div class="exp-card-content">
                    <h3>Safa Adhisya</h3>
                    <p><strong>Sign Language Interpreter</strong></p>
                    <p>
                        Safa’s journey at Kopi Cinta deepened her understanding of Deaf
                        culture, communication, and operational coordination—showing her
                        that inclusivity is something everyone must take part in.
                    </p>
                    <span class="exp-readmore">View Profile</span>
                </div>
            </a>

            <!-- Faris -->
            <a asp-page="/TeamFaris" class="exp-card-lg reveal team-card">
                <img src="/images/team/faris.jpg" class="team-img" alt="Faris Ristiansyah">
                <div class="exp-card-content">
                    <h3>Faris Ristiansyah</h3>
                    <p><strong>Generalist</strong></p>
                    <p>
                        What began as a job for Faris gradually became a deeper journey
                        of understanding, collaboration, and growth alongside Deaf friends
                        and the wider mission of Kopi Cinta.
                    </p>
                    <span class="exp-readmore">View Profile</span>
                </div>
            </a>

            <!-- Riza -->
            <a asp-page="/TeamRiza" class="exp-card-lg reveal team-card">
                <img src="/images/team/riza.jpg" class="team-img" alt="Riza Agung Pribadi">
                <div class="exp-card-content">
                    <h3>Riza Agung Pribadi</h3>
                    <p><strong>Finance</strong></p>
                    <p>
                        Working behind the scenes in finance, Riza sees inclusion not as
                        charity, but as creating real access—quiet work that still makes
                        meaningful connection possible.
                    </p>
                    <span class="exp-readmore">View Profile</span>
                </div>
            </a>

        </div>

    </div>
</section>